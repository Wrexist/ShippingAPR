<UserControl x:Class="ShippingAPR.App.Views.PortDashboardPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:res="clr-namespace:ShippingAPR.App.Resources">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12">
        <StackPanel Margin="8">

            <!-- ═══ Header ═══ -->
            <TextBlock Text="{x:Static res:Strings.PortActivity}" FontSize="16" FontWeight="Bold"
                       Foreground="{DynamicResource PrimaryTextBrush}"
                       Margin="0,0,0,4"/>
            <TextBlock Text="{x:Static res:Strings.PortActivitySubtitle}" FontSize="11"
                       Foreground="{DynamicResource SecondaryTextBrush}"
                       Margin="0,0,0,12"/>

            <!-- ═══ Port Selector ═══ -->
            <Border Style="{DynamicResource CardStyle}" Margin="0,0,0,10">
                <StackPanel>
                    <TextBlock Text="{x:Static res:Strings.SelectPort}" Style="{DynamicResource SubTextStyle}"
                               FontWeight="Bold" Margin="0,0,0,8"/>
                    <ComboBox ItemsSource="{Binding AvailablePorts}"
                              SelectedItem="{Binding SelectedPort}"
                              IsEditable="True"
                              Foreground="{DynamicResource PrimaryTextBrush}"
                              FontSize="13"/>
                </StackPanel>
            </Border>

            <!-- ═══ Congestion Indicator ═══ -->
            <Border Style="{DynamicResource CardStyle}" Margin="0,0,0,10">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <Border Width="3" Height="14" CornerRadius="2"
                                Background="{DynamicResource WarningBrush}" Margin="0,0,8,0"/>
                        <TextBlock Text="{x:Static res:Strings.Congestion}" Style="{DynamicResource SubTextStyle}"
                                   FontWeight="Bold" FontSize="11"/>
                    </StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <!-- Congestion bar -->
                            <Grid Height="8" Margin="0,0,0,6">
                                <Border Background="{DynamicResource GlassBorderBrush}" CornerRadius="4"/>
                                <Border CornerRadius="4" HorizontalAlignment="Left"
                                        MinWidth="4">
                                    <Border.Background>
                                        <SolidColorBrush Color="{Binding CongestionColor}"/>
                                    </Border.Background>
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="7" ShadowDepth="0" Opacity="0.5" Color="{Binding CongestionColor}"/>
                                    </Border.Effect>
                                </Border>
                            </Grid>
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="{Binding CongestionText}"
                                   FontWeight="Bold" FontSize="14" Margin="12,0,0,0">
                            <TextBlock.Foreground>
                                <SolidColorBrush Color="{Binding CongestionColor}"/>
                            </TextBlock.Foreground>
                        </TextBlock>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ═══ Live Stats ═══ -->
            <Border Style="{DynamicResource CardStyle}" Margin="0,0,0,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                        <TextBlock Text="{Binding VesselsInPort}" FontSize="20" FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   Foreground="{DynamicResource AccentBrush}"/>
                        <TextBlock Text="{x:Static res:Strings.InPort}" FontSize="10" HorizontalAlignment="Center"
                                   Style="{DynamicResource SubTextStyle}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                        <TextBlock Text="{Binding ArrivalsToday}" FontSize="20" FontWeight="Bold"
                                   HorizontalAlignment="Center" Foreground="#4CAF50"/>
                        <TextBlock Text="{x:Static res:Strings.Arrivals}" FontSize="10" HorizontalAlignment="Center"
                                   Style="{DynamicResource SubTextStyle}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                        <TextBlock Text="{Binding DeparturesToday}" FontSize="20" FontWeight="Bold"
                                   HorizontalAlignment="Center" Foreground="#F44336"/>
                        <TextBlock Text="{x:Static res:Strings.Departures}" FontSize="10" HorizontalAlignment="Center"
                                   Style="{DynamicResource SubTextStyle}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ═══ Tide & Sea Level ═══ -->
            <Border Style="{DynamicResource CardStyle}" Margin="0,0,0,10">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <Border Width="3" Height="14" CornerRadius="2"
                                Background="{DynamicResource InfoBrush}" Margin="0,0,8,0"/>
                        <TextBlock Text="{x:Static res:Strings.TideSeaLevel}" Style="{DynamicResource SubTextStyle}"
                                   FontWeight="Bold" FontSize="11"/>
                    </StackPanel>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock Text="{Binding TideStateIcon}" FontSize="16" FontWeight="Bold"
                                           VerticalAlignment="Center" Margin="0,0,4,0">
                                    <TextBlock.Foreground>
                                        <SolidColorBrush Color="{Binding TideColor}"/>
                                    </TextBlock.Foreground>
                                </TextBlock>
                                <TextBlock Text="{Binding CurrentTideLevelText}" FontSize="18" FontWeight="Bold"
                                           Foreground="{DynamicResource AccentBrush}"/>
                            </StackPanel>
                            <TextBlock Text="{Binding TideStateText}" FontSize="10"
                                       HorizontalAlignment="Center"
                                       Style="{DynamicResource SubTextStyle}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                            <TextBlock Text="{Binding NextHighTideText}" FontSize="16" FontWeight="Bold"
                                       HorizontalAlignment="Center" Foreground="#4CAF50"/>
                            <TextBlock Text="{x:Static res:Strings.HighTide}" FontSize="10" HorizontalAlignment="Center"
                                       Style="{DynamicResource SubTextStyle}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                            <TextBlock Text="{Binding NextLowTideText}" FontSize="16" FontWeight="Bold"
                                       HorizontalAlignment="Center" Foreground="#2196F3"/>
                            <TextBlock Text="{x:Static res:Strings.LowTide}" FontSize="10" HorizontalAlignment="Center"
                                       Style="{DynamicResource SubTextStyle}"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ═══ Recent Activity Board ═══ -->
            <Border Style="{DynamicResource CardStyle}" Margin="0,0,0,10">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <Border Width="3" Height="14" CornerRadius="2"
                                Background="{DynamicResource SuccessBrush}" Margin="0,0,8,0"/>
                        <TextBlock Text="{x:Static res:Strings.ArrivalsDeparturesBoard}" Style="{DynamicResource SubTextStyle}"
                                   FontWeight="Bold" FontSize="11"/>
                    </StackPanel>

                    <!-- Header Row -->
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="30"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="50"/>
                            <ColumnDefinition Width="60"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="" FontSize="10"
                                   Style="{DynamicResource SubTextStyle}"/>
                        <TextBlock Grid.Column="1" Text="{x:Static res:Strings.ColVessel}" FontSize="10"
                                   Style="{DynamicResource SubTextStyle}" FontWeight="Bold"/>
                        <TextBlock Grid.Column="2" Text="{x:Static res:Strings.ColTime}" FontSize="10"
                                   Style="{DynamicResource SubTextStyle}" FontWeight="Bold"/>
                        <TextBlock Grid.Column="3" Text="{x:Static res:Strings.ColSpeed}" FontSize="10"
                                   Style="{DynamicResource SubTextStyle}" FontWeight="Bold"/>
                    </Grid>

                    <ItemsControl ItemsSource="{Binding RecentActivity}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="30"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="50"/>
                                        <ColumnDefinition Width="60"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding ActivityIcon}"
                                               FontSize="14" FontWeight="Bold">
                                        <TextBlock.Foreground>
                                            <SolidColorBrush Color="{Binding ActivityColor}"/>
                                        </TextBlock.Foreground>
                                    </TextBlock>
                                    <TextBlock Grid.Column="1" Text="{Binding VesselName}"
                                               FontSize="11" Foreground="{DynamicResource PrimaryTextBrush}"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Grid.Column="2" Text="{Binding TimeText}"
                                               FontSize="11" Style="{DynamicResource SubTextStyle}"/>
                                    <TextBlock Grid.Column="3" Text="{Binding SpeedText}"
                                               FontSize="11" Style="{DynamicResource SubTextStyle}"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Empty state -->
                    <TextBlock Text="{x:Static res:Strings.NoPortActivity}"
                               HorizontalAlignment="Center"
                               Margin="0,12,0,0"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               FontSize="11">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Setter Property="Opacity" Value="0.5"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding RecentActivity.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
