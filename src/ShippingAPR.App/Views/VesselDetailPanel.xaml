<UserControl x:Class="ShippingAPR.App.Views.VesselDetailPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:res="clr-namespace:ShippingAPR.App.Resources">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <local:InverseBoolToVisConverter x:Key="InverseBoolToVis"
                                         xmlns:local="clr-namespace:ShippingAPR.App.Converters"/>
    </UserControl.Resources>

    <Grid>
        <!-- No vessel selected — elegant empty state -->
        <StackPanel HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Visibility="{Binding HasVessel, Converter={StaticResource InverseBoolToVis}}">
            <TextBlock Text="&#x26F5;" FontSize="48"
                       HorizontalAlignment="Center"
                       Foreground="{DynamicResource SecondaryTextBrush}"
                       Opacity="0.4"
                       Margin="0,0,0,12"/>
            <TextBlock Text="{x:Static res:Strings.SelectVesselHint}"
                       HorizontalAlignment="Center"
                       Foreground="{DynamicResource SecondaryTextBrush}"
                       FontSize="14"/>
            <TextBlock Text="{x:Static res:Strings.SelectVesselSubHint}"
                       HorizontalAlignment="Center"
                       Foreground="{DynamicResource SecondaryTextBrush}"
                       FontSize="11" Opacity="0.6"
                       Margin="0,4,0,0"/>
        </StackPanel>

        <!-- Vessel details — glass cards -->
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      Visibility="{Binding HasVessel, Converter={StaticResource BoolToVis}}">
            <StackPanel Margin="14">

                <!-- ═══ Vessel Name Header ═══ -->
                <StackPanel Margin="4,4,4,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding DisplayName}"
                                   FontSize="22" FontWeight="Bold"
                                   Foreground="{DynamicResource PrimaryTextBrush}"
                                   Margin="0,0,0,6"/>
                        <!-- Watch/Unwatch button -->
                        <Button Grid.Column="1" Command="{Binding ToggleWatchCommand}"
                                Style="{DynamicResource IconButtonStyle}"
                                ToolTip="Toggle watchlist"
                                FontSize="18" Padding="4"
                                VerticalAlignment="Top">
                            <Button.Content>
                                <TextBlock>
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="&#x2606;"/>
                                            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsWatched}" Value="True">
                                                    <Setter Property="Text" Value="&#x2605;"/>
                                                    <Setter Property="Foreground" Value="#FFD700"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Button.Content>
                        </Button>
                    </Grid>

                    <!-- Type as a pill badge -->
                    <Border Background="{DynamicResource AccentGlowBrush}"
                            CornerRadius="10"
                            Padding="10,4"
                            HorizontalAlignment="Left">
                        <TextBlock Text="{Binding TypeText}"
                                   FontSize="12" FontWeight="SemiBold"
                                   Foreground="{DynamicResource AccentBrush}"/>
                    </Border>
                </StackPanel>

                <!-- ═══ Identity Section ═══ -->
                <Border Style="{DynamicResource CardStyle}" Margin="0,0,0,10">
                    <StackPanel>
                        <!-- Section header inside card -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <Border Width="3" Height="14" CornerRadius="2"
                                    Background="{DynamicResource AccentBrush}"
                                    Margin="0,0,8,0"/>
                            <TextBlock Text="{x:Static res:Strings.Identity}"
                                       Style="{DynamicResource SubTextStyle}"
                                       FontWeight="Bold" FontSize="11"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition/>
                                <RowDefinition/>
                                <RowDefinition/>
                                <RowDefinition/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="{x:Static res:Strings.MMSI}"
                                       Style="{DynamicResource SubTextStyle}"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding MmsiText}"
                                       Style="{DynamicResource ValueTextStyle}"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="{x:Static res:Strings.IMO}" Margin="0,6,0,0"
                                       Style="{DynamicResource SubTextStyle}"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding ImoText}" Margin="0,6,0,0"
                                       Style="{DynamicResource ValueTextStyle}"/>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="{x:Static res:Strings.CallSign}" Margin="0,6,0,0"
                                       Style="{DynamicResource SubTextStyle}"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding CallSignText}" Margin="0,6,0,0"
                                       Style="{DynamicResource ValueTextStyle}"/>

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="{x:Static res:Strings.Flag}" Margin="0,6,0,0"
                                       Style="{DynamicResource SubTextStyle}"/>
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding FlagText}" Margin="0,6,0,0"
                                       Style="{DynamicResource ValueTextStyle}"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ═══ Navigation Section ═══ -->
                <Border Style="{DynamicResource CardStyle}" Margin="0,0,0,10">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <Border Width="3" Height="14" CornerRadius="2"
                                    Background="{DynamicResource SuccessBrush}"
                                    Margin="0,0,8,0"/>
                            <TextBlock Text="{x:Static res:Strings.Navigation}"
                                       Style="{DynamicResource SubTextStyle}"
                                       FontWeight="Bold" FontSize="11"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition/>
                                <RowDefinition/>
                                <RowDefinition/>
                                <RowDefinition/>
                                <RowDefinition/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="{x:Static res:Strings.Speed}"
                                       Style="{DynamicResource SubTextStyle}"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding SpeedText}"
                                       Style="{DynamicResource ValueTextStyle}" FontWeight="Bold"
                                       Foreground="{DynamicResource AccentBrush}"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="{x:Static res:Strings.Course}" Margin="0,6,0,0"
                                       Style="{DynamicResource SubTextStyle}"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding CourseText}" Margin="0,6,0,0"
                                       Style="{DynamicResource ValueTextStyle}"/>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="{x:Static res:Strings.Heading}" Margin="0,6,0,0"
                                       Style="{DynamicResource SubTextStyle}"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding HeadingText}" Margin="0,6,0,0"
                                       Style="{DynamicResource ValueTextStyle}"/>

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="{x:Static res:Strings.Status}" Margin="0,6,0,0"
                                       Style="{DynamicResource SubTextStyle}"/>
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding StatusText}" Margin="0,6,0,0"
                                       Style="{DynamicResource ValueTextStyle}"/>

                            <TextBlock Grid.Row="4" Grid.Column="0" Text="{x:Static res:Strings.Position}" Margin="0,6,0,0"
                                       Style="{DynamicResource SubTextStyle}"/>
                            <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding PositionText}" Margin="0,6,0,0"
                                       Style="{DynamicResource ValueTextStyle}" FontSize="12"
                                       Opacity="0.8"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ═══ Voyage & ETA Section ═══ -->
                <Border Style="{DynamicResource CardStyle}" Margin="0,0,0,10">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <Border Width="3" Height="14" CornerRadius="2"
                                    Background="{DynamicResource InfoBrush}"
                                    Margin="0,0,8,0"/>
                            <TextBlock Text="{x:Static res:Strings.VoyageEta}"
                                       Style="{DynamicResource SubTextStyle}"
                                       FontWeight="Bold" FontSize="11"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition/>
                                <RowDefinition/>
                                <RowDefinition/>
                                <RowDefinition/>
                                <RowDefinition/>
                                <RowDefinition/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="{x:Static res:Strings.Destination}"
                                       Style="{DynamicResource SubTextStyle}"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding DestinationText}"
                                       Style="{DynamicResource ValueTextStyle}" FontWeight="SemiBold"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="{x:Static res:Strings.Distance}" Margin="0,6,0,0"
                                       Style="{DynamicResource SubTextStyle}"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding DistanceText}" Margin="0,6,0,0"
                                       Style="{DynamicResource ValueTextStyle}"/>

                            <!-- Time to Arrival — prominent with glow -->
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="{x:Static res:Strings.TimeToArrival}" Margin="0,8,0,0"
                                       Style="{DynamicResource SubTextStyle}"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding TimeToArrivalText}" Margin="0,8,0,0"
                                       Foreground="{DynamicResource AccentBrush}"
                                       FontSize="18" FontWeight="Bold">
                                <TextBlock.Effect>
                                    <DropShadowEffect BlurRadius="12" ShadowDepth="0" Opacity="0.3"
                                                      Color="{DynamicResource AccentColor}"/>
                                </TextBlock.Effect>
                            </TextBlock>

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="{x:Static res:Strings.ETA}" Margin="0,6,0,0"
                                       Style="{DynamicResource SubTextStyle}"/>
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding EtaText}" Margin="0,6,0,0"
                                       Style="{DynamicResource ValueTextStyle}"/>

                            <TextBlock Grid.Row="4" Grid.Column="0" Text="{x:Static res:Strings.EffectiveSpeed}" Margin="0,6,0,0"
                                       Style="{DynamicResource SubTextStyle}"/>
                            <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding EffectiveSpeedText}" Margin="0,6,0,0"
                                       Style="{DynamicResource ValueTextStyle}"/>

                            <TextBlock Grid.Row="5" Grid.Column="0" Text="{x:Static res:Strings.CourseDev}" Margin="0,6,0,0"
                                       Style="{DynamicResource SubTextStyle}"/>
                            <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding CourseDeviationText}" Margin="0,6,0,0"
                                       Style="{DynamicResource ValueTextStyle}"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ═══ Dimensions Section ═══ -->
                <Border Style="{DynamicResource CardStyle}" Margin="0,0,0,10">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <Border Width="3" Height="14" CornerRadius="2"
                                    Background="{DynamicResource WarningBrush}"
                                    Margin="0,0,8,0"/>
                            <TextBlock Text="{x:Static res:Strings.Dimensions}"
                                       Style="{DynamicResource SubTextStyle}"
                                       FontWeight="Bold" FontSize="11"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition/>
                                <RowDefinition/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="{x:Static res:Strings.Size}"
                                       Style="{DynamicResource SubTextStyle}"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding DimensionsText}"
                                       Style="{DynamicResource ValueTextStyle}"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="{x:Static res:Strings.Draught}" Margin="0,6,0,0"
                                       Style="{DynamicResource SubTextStyle}"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding DraughtText}" Margin="0,6,0,0"
                                       Style="{DynamicResource ValueTextStyle}"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ═══ Voyage Story Section ═══ -->
                <Border Style="{DynamicResource CardStyle}" Margin="0,0,0,10">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <Border Width="3" Height="14" CornerRadius="2"
                                    Background="{DynamicResource AccentBrush}"
                                    Margin="0,0,8,0"/>
                            <TextBlock Text="Voyage Story"
                                       Style="{DynamicResource SubTextStyle}"
                                       FontWeight="Bold" FontSize="11"
                                       VerticalAlignment="Center"/>
                            <TextBlock Text=" &#x1F4D6;" FontSize="11" Opacity="0.6"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="{Binding VoyageStoryText}"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource PrimaryTextBrush}"
                                   FontSize="12" LineHeight="18"
                                   Opacity="0.85"/>
                    </StackPanel>
                </Border>

                <!-- ═══ Footer — Glass tinted info bar ═══ -->
                <Border Background="{DynamicResource GlassFillBrush}"
                        CornerRadius="10"
                        Padding="12,8"
                        Margin="0,4,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal">
                            <TextBlock Text="{x:Static res:Strings.LastUpdate}"
                                       Style="{DynamicResource SubTextStyle}"/>
                            <TextBlock Text="{Binding LastUpdateText}"
                                       Style="{DynamicResource SubTextStyle}" FontWeight="SemiBold"/>
                        </StackPanel>
                        <TextBlock Grid.Column="1"
                                   Text="{Binding TrackPointCount, StringFormat='Track: {0} pts'}"
                                   Style="{DynamicResource SubTextStyle}"
                                   Opacity="0.7"/>
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>

</UserControl>
