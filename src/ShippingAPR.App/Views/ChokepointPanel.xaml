<UserControl x:Class="ShippingAPR.App.Views.ChokepointPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:res="clr-namespace:ShippingAPR.App.Resources">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12">
        <StackPanel Margin="8">
            <TextBlock Text="{x:Static res:Strings.GlobalChokepoints}" FontSize="16" FontWeight="Bold"
                       Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,4"/>
            <TextBlock Text="{x:Static res:Strings.ChokepointsSubtitle}"
                       Style="{DynamicResource SubTextStyle}" FontSize="11" Opacity="0.7"
                       Margin="0,0,0,12"/>

            <ItemsControl ItemsSource="{Binding Chokepoints}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{DynamicResource InteractiveCardStyle}" Margin="0,0,0,8">
                            <StackPanel>
                                <!-- Header row -->
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Name}"
                                               FontSize="13" FontWeight="Bold"
                                               Foreground="{DynamicResource PrimaryTextBrush}"/>
                                    <Border Grid.Column="1" CornerRadius="6" Padding="8,2">
                                        <Border.Background>
                                            <SolidColorBrush Color="{Binding CongestionColor}"/>
                                        </Border.Background>
                                        <TextBlock Text="{Binding CongestionText}" FontSize="10"
                                                   FontWeight="Bold" Foreground="White"/>
                                    </Border>
                                </Grid>

                                <!-- Stats grid -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                                        <TextBlock Text="{Binding VesselsInTransit}" FontSize="18" FontWeight="Bold"
                                                   Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center"/>
                                        <TextBlock Text="{x:Static res:Strings.InTransit}" Style="{DynamicResource SubTextStyle}"
                                                   FontSize="9" HorizontalAlignment="Center"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                                        <TextBlock Text="{Binding TransitsLast24h}" FontSize="18" FontWeight="Bold"
                                                   Foreground="{DynamicResource PrimaryTextBrush}" HorizontalAlignment="Center"/>
                                        <TextBlock Text="{x:Static res:Strings.Transits24h}" Style="{DynamicResource SubTextStyle}"
                                                   FontSize="9" HorizontalAlignment="Center"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                                        <TextBlock Text="{Binding AvgSpeedText}" FontSize="14" FontWeight="Bold"
                                                   Foreground="{DynamicResource PrimaryTextBrush}" HorizontalAlignment="Center"/>
                                        <TextBlock Text="{x:Static res:Strings.AvgSpeed}" Style="{DynamicResource SubTextStyle}"
                                                   FontSize="9" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Grid>

                                <TextBlock Text="{Binding TypicalTransitText}" Margin="0,6,0,0"
                                           Style="{DynamicResource SubTextStyle}" FontSize="10"
                                           Opacity="0.6" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
