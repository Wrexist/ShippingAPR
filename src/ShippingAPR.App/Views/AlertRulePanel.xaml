<UserControl x:Class="ShippingAPR.App.Views.AlertRulePanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:res="clr-namespace:ShippingAPR.App.Resources">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12">
        <StackPanel Margin="8">

            <!-- ═══ Header ═══ -->
            <TextBlock Text="{x:Static res:Strings.SmartAlerts}" FontSize="16" FontWeight="Bold"
                       Foreground="{DynamicResource PrimaryTextBrush}"
                       Margin="0,0,0,4"/>
            <TextBlock Text="{x:Static res:Strings.SmartAlertsSubtitle}" FontSize="11"
                       Foreground="{DynamicResource SecondaryTextBrush}"
                       Margin="0,0,0,12"/>

            <!-- ═══ Quick Stats ═══ -->
            <Border Style="{DynamicResource CardStyle}" Margin="0,0,0,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                        <TextBlock Text="{Binding RuleCount}" FontSize="18" FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   Foreground="{DynamicResource AccentBrush}"/>
                        <TextBlock Text="{x:Static res:Strings.Rules}" FontSize="10" HorizontalAlignment="Center"
                                   Style="{DynamicResource SubTextStyle}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                        <TextBlock Text="{Binding AlertsFiredCount}" FontSize="18" FontWeight="Bold"
                                   HorizontalAlignment="Center" Foreground="#FF9800"/>
                        <TextBlock Text="{x:Static res:Strings.AlertsFired}" FontSize="10" HorizontalAlignment="Center"
                                   Style="{DynamicResource SubTextStyle}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ═══ New Rule Builder ═══ -->
            <Border Style="{DynamicResource CardStyle}" Margin="0,0,0,10">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <Border Width="3" Height="14" CornerRadius="2"
                                Background="{DynamicResource AccentBrush}" Margin="0,0,8,0"/>
                        <TextBlock Text="{x:Static res:Strings.CreateRule}" Style="{DynamicResource SubTextStyle}"
                                   FontWeight="Bold" FontSize="11"/>
                    </StackPanel>

                    <!-- Rule Name -->
                    <TextBlock Text="{x:Static res:Strings.RuleName}" FontSize="10"
                               Style="{DynamicResource SubTextStyle}" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding NewRuleName, UpdateSourceTrigger=PropertyChanged}"
                             FontSize="12" Padding="8,6" Margin="0,0,0,8"
                             Foreground="{DynamicResource PrimaryTextBrush}"
                             Background="{DynamicResource GlassFillBrush}"/>

                    <!-- Vessel Type -->
                    <TextBlock Text="{x:Static res:Strings.VesselTypeOptional}" FontSize="10"
                               Style="{DynamicResource SubTextStyle}" Margin="0,0,0,4"/>
                    <ComboBox ItemsSource="{Binding VesselTypeOptions}"
                              SelectedItem="{Binding NewRuleVesselType}"
                              FontSize="12" Margin="0,0,0,8"
                              Foreground="{DynamicResource PrimaryTextBrush}"/>

                    <!-- Speed Range -->
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{x:Static res:Strings.MinSpeedKn}" FontSize="10"
                                       Style="{DynamicResource SubTextStyle}" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding NewRuleMinSpeed, UpdateSourceTrigger=PropertyChanged}"
                                     FontSize="12" Padding="8,6"
                                     Foreground="{DynamicResource PrimaryTextBrush}"
                                     Background="{DynamicResource GlassFillBrush}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="{x:Static res:Strings.MaxSpeedKn}" FontSize="10"
                                       Style="{DynamicResource SubTextStyle}" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding NewRuleMaxSpeed, UpdateSourceTrigger=PropertyChanged}"
                                     FontSize="12" Padding="8,6"
                                     Foreground="{DynamicResource PrimaryTextBrush}"
                                     Background="{DynamicResource GlassFillBrush}"/>
                        </StackPanel>
                    </Grid>

                    <!-- Flag Filter -->
                    <TextBlock Text="{x:Static res:Strings.CountryFlagHint}" FontSize="10"
                               Style="{DynamicResource SubTextStyle}" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding NewRuleFlag, UpdateSourceTrigger=PropertyChanged}"
                             FontSize="12" Padding="8,6" Margin="0,0,0,10"
                             MaxLength="2"
                             Foreground="{DynamicResource PrimaryTextBrush}"
                             Background="{DynamicResource GlassFillBrush}"/>

                    <Button Content="{x:Static res:Strings.AddRule}"
                            Command="{Binding AddRuleCommand}"
                            Style="{DynamicResource AccentButtonStyle}"
                            FontSize="12" Padding="14,6"
                            HorizontalAlignment="Stretch"/>
                </StackPanel>
            </Border>

            <!-- ═══ Active Rules ═══ -->
            <Border Style="{DynamicResource CardStyle}" Margin="0,0,0,10">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <Border Width="3" Height="14" CornerRadius="2"
                                Background="{DynamicResource SuccessBrush}" Margin="0,0,8,0"/>
                        <TextBlock Text="{x:Static res:Strings.ActiveRules}" Style="{DynamicResource SubTextStyle}"
                                   FontWeight="Bold" FontSize="11"/>
                    </StackPanel>

                    <ItemsControl ItemsSource="{Binding Rules}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,0,6" Padding="10,8"
                                        Background="{DynamicResource GlassFillBrush}"
                                        CornerRadius="6">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <Ellipse Width="8" Height="8" Margin="0,0,6,0">
                                                    <Ellipse.Fill>
                                                        <SolidColorBrush Color="{Binding StatusColor}"/>
                                                    </Ellipse.Fill>
                                                </Ellipse>
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                                           FontSize="12"
                                                           Foreground="{DynamicResource PrimaryTextBrush}"/>
                                            </StackPanel>
                                            <TextBlock Text="{Binding ConditionsText}"
                                                       FontSize="10"
                                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                                       Margin="14,2,0,0"/>
                                        </StackPanel>
                                        <Button Grid.Column="1" Content="&#x2716;"
                                                Command="{Binding DataContext.RemoveRuleCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                ToolTip="{x:Static res:Strings.Remove}" AutomationProperties.Name="{x:Static res:Strings.Remove}"
                                                CommandParameter="{Binding Id}"
                                                Style="{DynamicResource IconButtonStyle}"
                                                FontSize="10"
                                                VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
