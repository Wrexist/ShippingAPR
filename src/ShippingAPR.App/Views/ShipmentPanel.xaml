<UserControl x:Class="ShippingAPR.App.Views.ShipmentPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:res="clr-namespace:ShippingAPR.App.Resources"
             xmlns:converters="clr-namespace:ShippingAPR.App.Converters">
    <UserControl.Resources>
        <converters:PercentToStarConverter x:Key="PercentToStar"/>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="12,8,12,4">
            <TextBlock Text="{x:Static res:Strings.SupplyChainTracker}" FontSize="16" FontWeight="Bold"
                       Foreground="{DynamicResource PrimaryTextBrush}"/>
            <TextBlock Text="{x:Static res:Strings.ShipmentSubtitle}"
                       Style="{DynamicResource SubTextStyle}" FontSize="11" Opacity="0.7"/>
        </StackPanel>

        <!-- Status summary -->
        <Border Grid.Row="1" Style="{DynamicResource CardStyle}" Margin="12,4,12,4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                    <TextBlock Text="{Binding PendingCount}" FontSize="18" FontWeight="Bold"
                               Foreground="#9E9E9E" HorizontalAlignment="Center"/>
                    <TextBlock Text="{x:Static res:Strings.Pending}" Style="{DynamicResource SubTextStyle}"
                               FontSize="9" HorizontalAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                    <TextBlock Text="{Binding InTransitCount}" FontSize="18" FontWeight="Bold"
                               Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center"/>
                    <TextBlock Text="{x:Static res:Strings.InTransit}" Style="{DynamicResource SubTextStyle}"
                               FontSize="9" HorizontalAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                    <TextBlock Text="{Binding ArrivedCount}" FontSize="18" FontWeight="Bold"
                               Foreground="{DynamicResource SuccessBrush}" HorizontalAlignment="Center"/>
                    <TextBlock Text="{x:Static res:Strings.Arrived}" Style="{DynamicResource SubTextStyle}"
                               FontSize="9" HorizontalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- New shipment form -->
        <Border Grid.Row="2" Style="{DynamicResource CardStyle}" Margin="12,4,12,4">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <Border Width="3" Height="14" CornerRadius="2"
                            Background="{DynamicResource AccentBrush}" Margin="0,0,8,0"/>
                    <TextBlock Text="{x:Static res:Strings.NewShipment}" Style="{DynamicResource SubTextStyle}"
                               FontWeight="Bold" FontSize="11"/>
                </StackPanel>
                <TextBox Text="{Binding NewShipmentName, UpdateSourceTrigger=PropertyChanged}"
                         Background="{DynamicResource GlassFillBrush}" BorderThickness="0"
                         Foreground="{DynamicResource PrimaryTextBrush}"
                         Padding="8,6" FontSize="12" Margin="0,0,0,4">
                    <TextBox.Tag><x:Static Member="res:Strings.ShipmentName"/></TextBox.Tag>
                </TextBox>
                <Grid Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" Text="{Binding NewOriginPort, UpdateSourceTrigger=PropertyChanged}"
                             Background="{DynamicResource GlassFillBrush}" BorderThickness="0"
                             Foreground="{DynamicResource PrimaryTextBrush}"
                             Padding="8,6" FontSize="11"/>
                    <TextBox Grid.Column="2" Text="{Binding NewDestPort, UpdateSourceTrigger=PropertyChanged}"
                             Background="{DynamicResource GlassFillBrush}" BorderThickness="0"
                             Foreground="{DynamicResource PrimaryTextBrush}"
                             Padding="8,6" FontSize="11"/>
                </Grid>
                <Button Content="{x:Static res:Strings.AddShipment}" Command="{Binding AddShipmentCommand}"
                        Style="{DynamicResource AccentButtonStyle}"
                        HorizontalAlignment="Stretch" Padding="8,6" FontSize="12"/>
            </StackPanel>
        </Border>

        <!-- Shipment list -->
        <ListBox Grid.Row="3" ItemsSource="{Binding Shipments}"
                 Background="Transparent" BorderThickness="0"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 Margin="8,0">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Setter Property="Padding" Value="0"/>
                    <Setter Property="Margin" Value="0,2"/>
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <ContentPresenter/>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Style="{DynamicResource CardStyle}" Padding="10,8" Margin="4,0">
                        <StackPanel>
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding Name}" FontWeight="SemiBold" FontSize="12"
                                           Foreground="{DynamicResource PrimaryTextBrush}"/>
                                <Border Grid.Column="1" CornerRadius="4" Padding="6,1" Margin="4,0">
                                    <Border.Background>
                                        <SolidColorBrush Color="{Binding StatusColor}"/>
                                    </Border.Background>
                                    <TextBlock Text="{Binding StatusText}" FontSize="9" Foreground="White" FontWeight="Bold"/>
                                </Border>
                                <Button Grid.Column="2" Content="&#x2715;"
                                        Command="{Binding DataContext.RemoveShipmentCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        ToolTip="{x:Static res:Strings.Remove}" AutomationProperties.Name="{x:Static res:Strings.Remove}"
                                        CommandParameter="{Binding Id}"
                                        Style="{DynamicResource GhostButtonStyle}" FontSize="9" Padding="4,0"/>
                            </Grid>
                            <TextBlock Text="{Binding RouteText}" FontSize="10"
                                       Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,4"/>

                            <!-- Progress bar -->
                            <Grid Height="6" Margin="0,0,0,4">
                                <Border Background="{DynamicResource GlassFillBrush}" CornerRadius="3"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="{Binding PercentComplete, Converter={StaticResource PercentToStar}}"/>
                                        <ColumnDefinition Width="{Binding PercentComplete, Converter={StaticResource PercentToStar}, ConverterParameter=remainder}"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" CornerRadius="3"
                                            Background="{DynamicResource AccentBrush}"/>
                                </Grid>
                            </Grid>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding ProgressText}" FontSize="10"
                                           Foreground="{DynamicResource SecondaryTextBrush}"/>
                                <TextBlock Grid.Column="1" Text="{Binding VesselText}" FontSize="10"
                                           Foreground="{DynamicResource AccentBrush}"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</UserControl>
