<UserControl x:Class="ShippingAPR.App.Views.DashboardPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:res="clr-namespace:ShippingAPR.App.Resources">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12">
        <StackPanel Margin="8">

            <!-- ═══ Overview ═══ -->
            <TextBlock Text="{x:Static res:Strings.Dashboard}" FontSize="16" FontWeight="Bold"
                       Foreground="{DynamicResource PrimaryTextBrush}"
                       Margin="0,0,0,12"/>

            <!-- Total vessels -->
            <Border Style="{DynamicResource CardStyle}" Margin="0,0,0,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{x:Static res:Strings.TotalVessels}"
                               Style="{DynamicResource SubTextStyle}" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="{Binding TotalVessels}"
                               FontSize="24" FontWeight="Bold"
                               Foreground="{DynamicResource AccentBrush}"/>
                </Grid>
            </Border>

            <!-- ═══ By Type ═══ -->
            <Border Style="{DynamicResource CardStyle}" Margin="0,0,0,8">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <Border Width="3" Height="14" CornerRadius="2"
                                Background="{DynamicResource AccentBrush}" Margin="0,0,8,0"/>
                        <TextBlock Text="{x:Static res:Strings.ByType}" Style="{DynamicResource SubTextStyle}"
                                   FontWeight="Bold" FontSize="11"/>
                    </StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition/>
                            <RowDefinition/>
                            <RowDefinition/>
                            <RowDefinition/>
                            <RowDefinition/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal">
                            <Ellipse Width="8" Height="8" Fill="#4CAF50" Margin="0,0,6,0"/>
                            <TextBlock Text="{x:Static res:Strings.Cargo}" Style="{DynamicResource SubTextStyle}"/>
                        </StackPanel>
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding CargoCount}"
                                   Style="{DynamicResource ValueTextStyle}" FontWeight="Bold"/>

                        <StackPanel Grid.Row="1" Grid.Column="0" Orientation="Horizontal" Margin="0,4,0,0">
                            <Ellipse Width="8" Height="8" Fill="#FF5722" Margin="0,0,6,0"/>
                            <TextBlock Text="{x:Static res:Strings.Tanker}" Style="{DynamicResource SubTextStyle}"/>
                        </StackPanel>
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding TankerCount}" Margin="0,4,0,0"
                                   Style="{DynamicResource ValueTextStyle}" FontWeight="Bold"/>

                        <StackPanel Grid.Row="2" Grid.Column="0" Orientation="Horizontal" Margin="0,4,0,0">
                            <Ellipse Width="8" Height="8" Fill="#2196F3" Margin="0,0,6,0"/>
                            <TextBlock Text="{x:Static res:Strings.Passenger}" Style="{DynamicResource SubTextStyle}"/>
                        </StackPanel>
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding PassengerCount}" Margin="0,4,0,0"
                                   Style="{DynamicResource ValueTextStyle}" FontWeight="Bold"/>

                        <StackPanel Grid.Row="3" Grid.Column="0" Orientation="Horizontal" Margin="0,4,0,0">
                            <Ellipse Width="8" Height="8" Fill="#00BCD4" Margin="0,0,6,0"/>
                            <TextBlock Text="{x:Static res:Strings.Fishing}" Style="{DynamicResource SubTextStyle}"/>
                        </StackPanel>
                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding FishingCount}" Margin="0,4,0,0"
                                   Style="{DynamicResource ValueTextStyle}" FontWeight="Bold"/>

                        <StackPanel Grid.Row="4" Grid.Column="0" Orientation="Horizontal" Margin="0,4,0,0">
                            <Ellipse Width="8" Height="8" Fill="#9E9E9E" Margin="0,0,6,0"/>
                            <TextBlock Text="{x:Static res:Strings.Other}" Style="{DynamicResource SubTextStyle}"/>
                        </StackPanel>
                        <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding OtherCount}" Margin="0,4,0,0"
                                   Style="{DynamicResource ValueTextStyle}" FontWeight="Bold"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ═══ Status Breakdown ═══ -->
            <Border Style="{DynamicResource CardStyle}" Margin="0,0,0,8">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <Border Width="3" Height="14" CornerRadius="2"
                                Background="{DynamicResource SuccessBrush}" Margin="0,0,8,0"/>
                        <TextBlock Text="{x:Static res:Strings.NavigationStatus}" Style="{DynamicResource SubTextStyle}"
                                   FontWeight="Bold" FontSize="11"/>
                    </StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition/>
                            <RowDefinition/>
                            <RowDefinition/>
                            <RowDefinition/>
                            <RowDefinition/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="{x:Static res:Strings.UnderWay}"
                                   Style="{DynamicResource SubTextStyle}"/>
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding UnderWayCount}"
                                   Style="{DynamicResource ValueTextStyle}" FontWeight="Bold"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="{x:Static res:Strings.AtAnchor}" Margin="0,4,0,0"
                                   Style="{DynamicResource SubTextStyle}"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding AtAnchorCount}" Margin="0,4,0,0"
                                   Style="{DynamicResource ValueTextStyle}" FontWeight="Bold"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="{x:Static res:Strings.Moored}" Margin="0,4,0,0"
                                   Style="{DynamicResource SubTextStyle}"/>
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding MooredCount}" Margin="0,4,0,0"
                                   Style="{DynamicResource ValueTextStyle}" FontWeight="Bold"/>

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="{x:Static res:Strings.AvgSpeed}" Margin="0,4,0,0"
                                   Style="{DynamicResource SubTextStyle}"/>
                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding AverageSpeedText}" Margin="0,4,0,0"
                                   Foreground="{DynamicResource AccentBrush}" FontWeight="Bold" FontSize="14"/>

                        <TextBlock Grid.Row="4" Grid.Column="0" Text="{x:Static res:Strings.Watched}" Margin="0,4,0,0"
                                   Style="{DynamicResource SubTextStyle}"/>
                        <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal" Margin="0,4,0,0">
                            <TextBlock Text="&#x2605;" Foreground="#FFD700" FontSize="12" Margin="0,0,4,0"/>
                            <TextBlock Text="{Binding WatchedCount}"
                                       Style="{DynamicResource ValueTextStyle}" FontWeight="Bold"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ═══ Top Destinations ═══ -->
            <Border Style="{DynamicResource CardStyle}" Margin="0,0,0,8">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <Border Width="3" Height="14" CornerRadius="2"
                                Background="{DynamicResource InfoBrush}" Margin="0,0,8,0"/>
                        <TextBlock Text="{x:Static res:Strings.TopDestinations}" Style="{DynamicResource SubTextStyle}"
                                   FontWeight="Bold" FontSize="11"/>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="{Binding TopDestination1}" Style="{DynamicResource ValueTextStyle}"
                                   FontSize="12" Margin="0,0,0,3"/>
                        <TextBlock Text="{Binding TopDestination2}" Style="{DynamicResource SubTextStyle}"
                                   FontSize="11" Margin="0,0,0,2"/>
                        <TextBlock Text="{Binding TopDestination3}" Style="{DynamicResource SubTextStyle}"
                                   FontSize="11" Margin="0,0,0,2"/>
                        <TextBlock Text="{Binding TopDestination4}" Style="{DynamicResource SubTextStyle}"
                                   FontSize="11" Margin="0,0,0,2"/>
                        <TextBlock Text="{Binding TopDestination5}" Style="{DynamicResource SubTextStyle}"
                                   FontSize="11"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ═══ Fleet Emissions ═══ -->
            <Border Style="{DynamicResource CardStyle}" Margin="0,0,0,8">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <Border Width="3" Height="14" CornerRadius="2"
                                Background="{DynamicResource SuccessBrush}" Margin="0,0,8,0"/>
                        <TextBlock Text="{x:Static res:Strings.FleetEmissions}" Style="{DynamicResource SubTextStyle}"
                                   FontWeight="Bold" FontSize="11"/>
                    </StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition/>
                            <RowDefinition/>
                            <RowDefinition/>
                            <RowDefinition/>
                            <RowDefinition/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="{x:Static res:Strings.TotalCo2}"
                                   Style="{DynamicResource SubTextStyle}"/>
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding FleetCo2Text}"
                                   Foreground="{DynamicResource AccentBrush}" FontWeight="Bold" FontSize="14"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="{x:Static res:Strings.TotalFuel}" Margin="0,4,0,0"
                                   Style="{DynamicResource SubTextStyle}"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding FleetFuelText}" Margin="0,4,0,0"
                                   Style="{DynamicResource ValueTextStyle}" FontWeight="Bold"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="{x:Static res:Strings.VesselsMeasured}" Margin="0,4,0,0"
                                   Style="{DynamicResource SubTextStyle}"/>
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding EmissionsVesselCount}" Margin="0,4,0,0"
                                   Style="{DynamicResource ValueTextStyle}" FontWeight="Bold"/>

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="{x:Static res:Strings.HighestEmitter}" Margin="0,4,0,0"
                                   Style="{DynamicResource SubTextStyle}"/>
                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding HighestEmitterText}" Margin="0,4,0,0"
                                   Foreground="{DynamicResource ErrorBrush}" FontSize="11"/>

                        <TextBlock Grid.Row="4" Grid.Column="0" Text="{x:Static res:Strings.CleanestVessel}" Margin="0,4,0,0"
                                   Style="{DynamicResource SubTextStyle}"/>
                        <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding CleanestVesselText}" Margin="0,4,0,0"
                                   Foreground="{DynamicResource SuccessBrush}" FontSize="11"/>
                    </Grid>

                    <!-- CII Distribution -->
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0" HorizontalAlignment="Center">
                        <Border CornerRadius="6" Padding="8,3" Margin="2,0" Background="#3034D399">
                            <TextBlock FontSize="11" Foreground="#34D399" FontWeight="Bold">
                                <Run Text="A:"/><Run Text="{Binding CiiACount}"/>
                            </TextBlock>
                        </Border>
                        <Border CornerRadius="6" Padding="8,3" Margin="2,0" Background="#3060A5FA">
                            <TextBlock FontSize="11" Foreground="#60A5FA" FontWeight="Bold">
                                <Run Text="B:"/><Run Text="{Binding CiiBCount}"/>
                            </TextBlock>
                        </Border>
                        <Border CornerRadius="6" Padding="8,3" Margin="2,0" Background="#30FBBF24">
                            <TextBlock FontSize="11" Foreground="#FBBF24" FontWeight="Bold">
                                <Run Text="C:"/><Run Text="{Binding CiiCCount}"/>
                            </TextBlock>
                        </Border>
                        <Border CornerRadius="6" Padding="8,3" Margin="2,0" Background="#30FB923C">
                            <TextBlock FontSize="11" Foreground="#FB923C" FontWeight="Bold">
                                <Run Text="D:"/><Run Text="{Binding CiiDCount}"/>
                            </TextBlock>
                        </Border>
                        <Border CornerRadius="6" Padding="8,3" Margin="2,0" Background="#30EF4444">
                            <TextBlock FontSize="11" Foreground="#EF4444" FontWeight="Bold">
                                <Run Text="E:"/><Run Text="{Binding CiiECount}"/>
                            </TextBlock>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ═══ Vessel of the Day Spotlight ═══ -->
            <Border Style="{DynamicResource CardStyle}" Margin="0,0,0,8"
                    Visibility="{Binding HasSpotlight, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <Border Width="3" Height="14" CornerRadius="2"
                                Background="#FFD700" Margin="0,0,8,0"/>
                        <TextBlock Text="{x:Static res:Strings.VesselSpotlight}" Style="{DynamicResource SubTextStyle}"
                                   FontWeight="Bold" FontSize="11"/>
                    </StackPanel>
                    <TextBlock Text="{Binding SpotlightVesselName}" FontSize="16" FontWeight="Bold"
                               Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,4"/>
                    <TextBlock Text="{Binding SpotlightReason}" Style="{DynamicResource SubTextStyle}"
                               FontSize="11" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
