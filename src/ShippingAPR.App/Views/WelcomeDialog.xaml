<Window x:Class="ShippingAPR.App.Views.WelcomeDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:res="clr-namespace:ShippingAPR.App.Resources"
        Title="{x:Static res:Strings.WelcomeTitle}"
        Width="560" Height="720"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent">

    <!-- Outer glow effect container -->
    <Border Margin="20">
        <Border.Effect>
            <DropShadowEffect BlurRadius="40" ShadowDepth="0" Opacity="0.4"
                              Color="{DynamicResource AccentColor}"/>
        </Border.Effect>

        <!-- Main glass container -->
        <Border Background="{DynamicResource PrimaryBackgroundBrush}"
                CornerRadius="20"
                BorderThickness="1"
                BorderBrush="{DynamicResource GlassEdgeBrush}"
                Padding="44">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>  <!-- 0: Title -->
                    <RowDefinition Height="Auto"/>  <!-- 1: Subtitle -->
                    <RowDefinition Height="Auto"/>  <!-- 2: Feature pills -->
                    <RowDefinition Height="Auto"/>  <!-- 3: Step 1 -->
                    <RowDefinition Height="Auto"/>  <!-- 4: Step 2 -->
                    <RowDefinition Height="Auto"/>  <!-- 5: Test result -->
                    <RowDefinition Height="*"/>     <!-- 6: Spacer -->
                    <RowDefinition Height="Auto"/>  <!-- 7: Buttons -->
                    <RowDefinition Height="Auto"/>  <!-- 8: Helper text -->
                </Grid.RowDefinitions>

                <!-- App icon + Title -->
                <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,0,0,6">
                    <Border Width="56" Height="56" CornerRadius="14"
                            HorizontalAlignment="Center" Margin="0,0,0,16"
                            Background="{DynamicResource AccentGradientBrush}">
                        <TextBlock Text="S" FontSize="28" FontWeight="Bold"
                                   Foreground="White"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="{x:Static res:Strings.WelcomeTitle}"
                               FontSize="26" FontWeight="Bold"
                               Foreground="{DynamicResource PrimaryTextBrush}"
                               HorizontalAlignment="Center"/>
                </StackPanel>

                <TextBlock Grid.Row="1"
                           Text="{x:Static res:Strings.AppSubtitle}"
                           FontSize="14"
                           Foreground="{DynamicResource SecondaryTextBrush}"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,16"/>

                <!-- Feature highlights -->
                <WrapPanel Grid.Row="2" HorizontalAlignment="Center" Margin="0,0,0,20">
                    <Border Background="{DynamicResource GlassFillBrush}"
                            CornerRadius="8" Padding="10,5" Margin="3">
                        <TextBlock Text="&#x1F6A2; Live ship positions"
                                   Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11.5"/>
                    </Border>
                    <Border Background="{DynamicResource GlassFillBrush}"
                            CornerRadius="8" Padding="10,5" Margin="3">
                        <TextBlock Text="&#x23F1; ETA calculations"
                                   Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11.5"/>
                    </Border>
                    <Border Background="{DynamicResource GlassFillBrush}"
                            CornerRadius="8" Padding="10,5" Margin="3">
                        <TextBlock Text="&#x1F4CD; Area monitoring"
                                   Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11.5"/>
                    </Border>
                    <Border Background="{DynamicResource GlassFillBrush}"
                            CornerRadius="8" Padding="10,5" Margin="3">
                        <TextBlock Text="&#x1F50D; Vessel search"
                                   Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11.5"/>
                    </Border>
                </WrapPanel>

                <!-- Step 1: Choose Provider + Get API Key -->
                <StackPanel Grid.Row="3" Margin="0,0,0,24">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <Border Width="26" Height="26" CornerRadius="13"
                                Background="{DynamicResource AccentGlowBrush}"
                                Margin="0,0,10,0">
                            <TextBlock Text="1" FontSize="13" FontWeight="Bold"
                                       Foreground="{DynamicResource AccentBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="{x:Static res:Strings.WelcomeStep1}"
                                   FontSize="15" FontWeight="SemiBold"
                                   Foreground="{DynamicResource PrimaryTextBrush}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Provider selector -->
                    <StackPanel Orientation="Horizontal" Margin="36,0,0,10">
                        <TextBlock Text="Provider:" FontSize="13"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <ComboBox x:Name="ProviderSelector" SelectedIndex="0" Width="180">
                            <ComboBoxItem Content="AisStream (free, WebSocket)"/>
                            <ComboBoxItem Content="Datalastic (REST API)"/>
                            <ComboBoxItem Content="Data Docked (REST + Satellite)"/>
                        </ComboBox>
                    </StackPanel>

                    <TextBlock Text="{x:Static res:Strings.WelcomeStep1Desc}"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               FontSize="13"
                               Margin="36,0,0,10"/>
                    <Button Content="Open aisstream.io"
                            Click="OpenAisStreamSite"
                            Style="{DynamicResource GhostButtonStyle}"
                            HorizontalAlignment="Left"
                            Margin="36,0,0,0"/>
                </StackPanel>

                <!-- Step 2: Enter API Key -->
                <StackPanel Grid.Row="4" Margin="0,0,0,20">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <Border Width="26" Height="26" CornerRadius="13"
                                Background="{DynamicResource AccentGlowBrush}"
                                Margin="0,0,10,0">
                            <TextBlock Text="2" FontSize="13" FontWeight="Bold"
                                       Foreground="{DynamicResource AccentBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="{x:Static res:Strings.WelcomeStep2}"
                                   FontSize="15" FontWeight="SemiBold"
                                   Foreground="{DynamicResource PrimaryTextBrush}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                    <Border Margin="36,0,0,0"
                            Background="{DynamicResource GlassFillBrush}"
                            BorderBrush="{DynamicResource GlassBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="0">
                        <PasswordBox x:Name="ApiKeyInput"
                                     Background="Transparent"
                                     Foreground="{DynamicResource PrimaryTextBrush}"
                                     BorderThickness="0"
                                     Padding="14,12"
                                     FontSize="14"
                                     FontFamily="Consolas"/>
                    </Border>
                </StackPanel>

                <!-- Test Result -->
                <TextBlock Grid.Row="5"
                           x:Name="TestResultText"
                           FontSize="13"
                           Margin="36,0,0,16"
                           Visibility="Collapsed"/>

                <!-- Buttons -->
                <StackPanel Grid.Row="7" Orientation="Horizontal"
                            HorizontalAlignment="Right">
                    <!-- Skip button -->
                    <Button Click="SkipClick"
                            Style="{DynamicResource GhostButtonStyle}"
                            Margin="0,0,12,0"
                            Padding="18,10"
                            FontSize="13">
                        <TextBlock Text="Skip for now"
                                   Foreground="{DynamicResource SecondaryTextBrush}"/>
                    </Button>

                    <!-- Get Started button -->
                    <Button Content="{x:Static res:Strings.GetStarted}"
                            Click="GetStartedClick"
                            Style="{DynamicResource AccentButtonStyle}"
                            Padding="28,12"
                            FontSize="14"/>
                </StackPanel>

                <!-- Helper text -->
                <TextBlock Grid.Row="8"
                           Text="You can add your API key later in Settings."
                           FontSize="11.5"
                           Foreground="{DynamicResource SecondaryTextBrush}"
                           Opacity="0.6"
                           HorizontalAlignment="Right"
                           Margin="0,10,0,0"/>
            </Grid>
        </Border>
    </Border>
</Window>
