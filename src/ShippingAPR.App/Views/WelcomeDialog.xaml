<Window x:Class="ShippingAPR.App.Views.WelcomeDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Welcome to ShippingAPR"
        Width="560" Height="620"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent">

    <!-- Outer glow effect container -->
    <Border Margin="20">
        <Border.Effect>
            <DropShadowEffect BlurRadius="40" ShadowDepth="0" Opacity="0.4" Color="#6C63FF"/>
        </Border.Effect>

        <!-- Main glass container -->
        <Border Background="#E8101020"
                CornerRadius="20"
                BorderThickness="1"
                Padding="44">
            <Border.BorderBrush>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#40FFFFFF" Offset="0"/>
                    <GradientStop Color="#15FFFFFF" Offset="0.5"/>
                    <GradientStop Color="#08FFFFFF" Offset="1"/>
                </LinearGradientBrush>
            </Border.BorderBrush>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>  <!-- 0: Title -->
                    <RowDefinition Height="Auto"/>  <!-- 1: Subtitle -->
                    <RowDefinition Height="Auto"/>  <!-- 2: Feature pills -->
                    <RowDefinition Height="Auto"/>  <!-- 3: Step 1 -->
                    <RowDefinition Height="Auto"/>  <!-- 4: Step 2 -->
                    <RowDefinition Height="Auto"/>  <!-- 5: Test result -->
                    <RowDefinition Height="*"/>     <!-- 6: Spacer -->
                    <RowDefinition Height="Auto"/>  <!-- 7: Buttons -->
                    <RowDefinition Height="Auto"/>  <!-- 8: Helper text -->
                </Grid.RowDefinitions>

                <!-- App icon + Title -->
                <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,0,0,6">
                    <Border Width="56" Height="56" CornerRadius="14"
                            HorizontalAlignment="Center" Margin="0,0,0,16">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#FF6C63FF" Offset="0"/>
                                <GradientStop Color="#FF9D97FF" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <TextBlock Text="S" FontSize="28" FontWeight="Bold"
                                   Foreground="White"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="Welcome to ShippingAPR"
                               FontSize="26" FontWeight="Bold"
                               Foreground="#FFF0F0F8"
                               HorizontalAlignment="Center"/>
                </StackPanel>

                <TextBlock Grid.Row="1"
                           Text="Real-Time Ship Tracking for Swedish Waters"
                           FontSize="14"
                           Foreground="#88A0A8C0"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,16"/>

                <!-- Feature highlights -->
                <WrapPanel Grid.Row="2" HorizontalAlignment="Center" Margin="0,0,0,20">
                    <Border Background="#20FFFFFF" CornerRadius="8" Padding="10,5" Margin="3">
                        <TextBlock Text="&#x1F6A2; Live ship positions" Foreground="#CCA0A8C0" FontSize="11.5"/>
                    </Border>
                    <Border Background="#20FFFFFF" CornerRadius="8" Padding="10,5" Margin="3">
                        <TextBlock Text="&#x23F1; ETA calculations" Foreground="#CCA0A8C0" FontSize="11.5"/>
                    </Border>
                    <Border Background="#20FFFFFF" CornerRadius="8" Padding="10,5" Margin="3">
                        <TextBlock Text="&#x1F4CD; Area monitoring" Foreground="#CCA0A8C0" FontSize="11.5"/>
                    </Border>
                    <Border Background="#20FFFFFF" CornerRadius="8" Padding="10,5" Margin="3">
                        <TextBlock Text="&#x1F50D; Vessel search" Foreground="#CCA0A8C0" FontSize="11.5"/>
                    </Border>
                </WrapPanel>

                <!-- Step 1: Get API Key -->
                <StackPanel Grid.Row="3" Margin="0,0,0,24">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <!-- Step number circle -->
                        <Border Width="26" Height="26" CornerRadius="13"
                                Background="#306C63FF"
                                Margin="0,0,10,0">
                            <TextBlock Text="1" FontSize="13" FontWeight="Bold"
                                       Foreground="#FF9D97FF"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Get your free API key"
                                   FontSize="15" FontWeight="SemiBold"
                                   Foreground="#FFF0F0F8"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock TextWrapping="Wrap"
                               Foreground="#88A0A8C0"
                               FontSize="13"
                               Margin="36,0,0,10">
                        Sign up for a free account at aisstream.io to get an API key
                        for real-time AIS ship tracking data worldwide.
                    </TextBlock>
                    <Button Content="Open aisstream.io"
                            Click="OpenAisStreamSite"
                            Background="#28FFFFFF"
                            Foreground="#FFF0F0F8"
                            BorderThickness="1"
                            BorderBrush="#30FFFFFF"
                            Padding="16,8"
                            Cursor="Hand"
                            FontSize="13"
                            HorizontalAlignment="Left"
                            Margin="36,0,0,0"
                            RenderTransformOrigin="0.5,0.5">
                        <Button.RenderTransform>
                            <ScaleTransform ScaleX="1" ScaleY="1"/>
                        </Button.RenderTransform>
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                        CornerRadius="10"
                                        Padding="{TemplateBinding Padding}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        BorderBrush="{TemplateBinding BorderBrush}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="#38FFFFFF"/>
                                        <Setter TargetName="Bd" Property="BorderBrush" Value="#50FFFFFF"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                        <Button.Triggers>
                            <EventTrigger RoutedEvent="MouseEnter">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX" To="1.04" Duration="0:0:0.12"/>
                                        <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY" To="1.04" Duration="0:0:0.12"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <EventTrigger RoutedEvent="MouseLeave">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX" To="1.0" Duration="0:0:0.15"/>
                                        <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY" To="1.0" Duration="0:0:0.15"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </Button.Triggers>
                    </Button>
                </StackPanel>

                <!-- Step 2: Enter API Key -->
                <StackPanel Grid.Row="4" Margin="0,0,0,20">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <Border Width="26" Height="26" CornerRadius="13"
                                Background="#306C63FF"
                                Margin="0,0,10,0">
                            <TextBlock Text="2" FontSize="13" FontWeight="Bold"
                                       Foreground="#FF9D97FF"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Enter your API key"
                                   FontSize="15" FontWeight="SemiBold"
                                   Foreground="#FFF0F0F8"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                    <Border Margin="36,0,0,0"
                            Background="#20FFFFFF"
                            BorderBrush="#25FFFFFF"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="0">
                        <TextBox x:Name="ApiKeyInput"
                                 Background="Transparent"
                                 Foreground="#FFF0F0F8"
                                 BorderThickness="0"
                                 Padding="14,12"
                                 FontSize="14"
                                 FontFamily="Consolas"
                                 CaretBrush="#FF6C63FF"/>
                    </Border>
                </StackPanel>

                <!-- Test Result -->
                <TextBlock Grid.Row="5"
                           x:Name="TestResultText"
                           FontSize="13"
                           Margin="36,0,0,16"
                           Visibility="Collapsed"/>

                <!-- Buttons — glass reactive -->
                <StackPanel Grid.Row="7" Orientation="Horizontal"
                            HorizontalAlignment="Right">
                    <!-- Skip button — ghost glass -->
                    <Button Content="Explore without API key"
                            Click="SkipClick"
                            Background="Transparent"
                            Foreground="#88A0A8C0"
                            BorderThickness="1"
                            BorderBrush="#20FFFFFF"
                            Padding="18,10"
                            Cursor="Hand"
                            FontSize="13"
                            Margin="0,0,12,0"
                            RenderTransformOrigin="0.5,0.5">
                        <Button.RenderTransform>
                            <ScaleTransform ScaleX="1" ScaleY="1"/>
                        </Button.RenderTransform>
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="SkipBd" Background="{TemplateBinding Background}"
                                        CornerRadius="10"
                                        Padding="{TemplateBinding Padding}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        BorderBrush="{TemplateBinding BorderBrush}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="SkipBd" Property="Background" Value="#18FFFFFF"/>
                                        <Setter Property="Foreground" Value="#FFF0F0F8"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                        <Button.Triggers>
                            <EventTrigger RoutedEvent="MouseEnter">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX" To="1.03" Duration="0:0:0.12"/>
                                        <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY" To="1.03" Duration="0:0:0.12"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <EventTrigger RoutedEvent="MouseLeave">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX" To="1.0" Duration="0:0:0.15"/>
                                        <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY" To="1.0" Duration="0:0:0.15"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </Button.Triggers>
                    </Button>

                    <!-- Get Started — accent reactive -->
                    <Button Content="Get Started"
                            Click="GetStartedClick"
                            Foreground="White"
                            BorderThickness="0"
                            Padding="28,12"
                            Cursor="Hand"
                            FontSize="14"
                            FontWeight="SemiBold"
                            RenderTransformOrigin="0.5,0.5">
                        <Button.RenderTransform>
                            <ScaleTransform ScaleX="1" ScaleY="1"/>
                        </Button.RenderTransform>
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="StartBd" CornerRadius="12"
                                        Padding="{TemplateBinding Padding}">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#FF6C63FF" Offset="0"/>
                                            <GradientStop Color="#FF8B83FF" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="20" ShadowDepth="0" Opacity="0.4" Color="#6C63FF"/>
                                    </Border.Effect>
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="StartBd" Property="Background">
                                            <Setter.Value>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                    <GradientStop Color="#FF8B83FF" Offset="0"/>
                                                    <GradientStop Color="#FFA9A3FF" Offset="1"/>
                                                </LinearGradientBrush>
                                            </Setter.Value>
                                        </Setter>
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter Property="RenderTransform">
                                            <Setter.Value>
                                                <ScaleTransform ScaleX="0.96" ScaleY="0.96"/>
                                            </Setter.Value>
                                        </Setter>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                        <Button.Triggers>
                            <EventTrigger RoutedEvent="MouseEnter">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX" To="1.05" Duration="0:0:0.15">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY" To="1.05" Duration="0:0:0.15">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <EventTrigger RoutedEvent="MouseLeave">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX" To="1.0" Duration="0:0:0.2">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY" To="1.0" Duration="0:0:0.2">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </Button.Triggers>
                    </Button>
                </StackPanel>

                <!-- Helper text -->
                <TextBlock Grid.Row="8"
                           Text="You can add your API key later from the app."
                           FontSize="11.5"
                           Foreground="#55A0A8C0"
                           HorizontalAlignment="Right"
                           Margin="0,10,0,0"/>
            </Grid>
        </Border>
    </Border>
</Window>
