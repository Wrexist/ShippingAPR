<UserControl x:Class="ShippingAPR.App.Views.NotificationCenterPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:services="clr-namespace:ShippingAPR.Services;assembly=ShippingAPR.Services">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Padding="14,12"
                Background="Transparent">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Notifications"
                           Style="{DynamicResource HeaderTextStyle}"
                           VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="Mark Read"
                            Command="{Binding MarkAllReadCommand}"
                            Style="{DynamicResource GhostButtonStyle}"
                            FontSize="10" Padding="8,3" Margin="0,0,4,0"/>
                    <Button Content="Clear"
                            Command="{Binding ClearAllCommand}"
                            Style="{DynamicResource GhostButtonStyle}"
                            FontSize="10" Padding="8,3"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Accent divider -->
        <Border Grid.Row="0" VerticalAlignment="Bottom" Height="2" Margin="14,0"
                CornerRadius="1">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="{DynamicResource AccentColor}" Offset="0"/>
                    <GradientStop Color="Transparent" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
        </Border>

        <!-- Empty state -->
        <TextBlock Grid.Row="1" Text="No notifications yet"
                   Foreground="{DynamicResource SecondaryTextBrush}"
                   FontSize="13" HorizontalAlignment="Center"
                   VerticalAlignment="Center" Opacity="0.6">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Notifications.Count}" Value="0">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>

        <!-- Notification list -->
        <ListBox Grid.Row="1"
                 ItemsSource="{Binding Notifications}"
                 Background="Transparent"
                 BorderThickness="0"
                 Padding="6,6"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 VirtualizingPanel.IsVirtualizing="True"
                 VirtualizingPanel.VirtualizationMode="Recycling">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Setter Property="Padding" Value="0"/>
                    <Setter Property="Margin" Value="0"/>
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="IsHitTestVisible" Value="False"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <ContentPresenter/>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate DataType="{x:Type services:NotificationMessage}">
                    <Border Padding="12,8" Margin="4,2"
                            CornerRadius="8"
                            Background="{DynamicResource GlassFillBrush}">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <!-- Type icon -->
                                <TextBlock Grid.Column="0" FontSize="14" Margin="0,0,8,0"
                                           VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="&#x2139;"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Type}" Value="VesselEntered">
                                                    <Setter Property="Text" Value="&#x2B06;"/>
                                                    <Setter Property="Foreground" Value="#4CAF50"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Type}" Value="VesselLeft">
                                                    <Setter Property="Text" Value="&#x2B07;"/>
                                                    <Setter Property="Foreground" Value="#FF5722"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Type}" Value="WatchlistAlert">
                                                    <Setter Property="Text" Value="&#x2605;"/>
                                                    <Setter Property="Foreground" Value="#FFD700"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Type}" Value="CollisionRisk">
                                                    <Setter Property="Text" Value="&#x26A0;"/>
                                                    <Setter Property="Foreground" Value="#F44336"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Type}" Value="Warning">
                                                    <Setter Property="Text" Value="&#x26A0;"/>
                                                    <Setter Property="Foreground" Value="#FF9800"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <!-- Title -->
                                <TextBlock Grid.Column="1" Text="{Binding Title}"
                                           Foreground="{DynamicResource PrimaryTextBrush}"
                                           FontSize="12" FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis"/>
                                <!-- Time -->
                                <TextBlock Grid.Column="2"
                                           Text="{Binding Timestamp, StringFormat='{}{0:HH:mm}'}"
                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                           FontSize="10" Opacity="0.7"
                                           VerticalAlignment="Center"/>
                            </Grid>
                            <TextBlock Text="{Binding Body}"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       FontSize="11" TextWrapping="Wrap"
                                       Margin="22,2,0,0"/>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</UserControl>
