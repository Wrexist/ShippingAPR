<Window x:Class="ShippingAPR.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:ShippingAPR.App.Views"
        xmlns:converters="clr-namespace:ShippingAPR.App.Converters"
        xmlns:res="clr-namespace:ShippingAPR.App.Resources"
        Title="ShippingAPR - Real-Time Ship Tracker"
        Width="1400" Height="900"
        MinWidth="1000" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Icon="pack://application:,,,/Assets/Icons/app.ico"
        Background="{DynamicResource PrimaryBackgroundBrush}">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <converters:InverseBoolToVisConverter x:Key="InverseBoolToVis"/>
    </Window.Resources>

    <Grid Margin="6">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ═══════════════════════════════════════════════════════
             TOP BAR — Floating Glass Header
             ═══════════════════════════════════════════════════════ -->
        <Border Grid.Row="0" x:Name="TopBar"
                Background="{DynamicResource GlassFillBrush}"
                BorderBrush="{DynamicResource GlassEdgeBrush}"
                BorderThickness="1"
                CornerRadius="{DynamicResource LargeCornerRadius}"
                Padding="18,12"
                Margin="2,2,2,4">
            <Border.Effect>
                <DropShadowEffect BlurRadius="16" ShadowDepth="3" Opacity="0.15" Color="#000000" Direction="270"/>
            </Border.Effect>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- App Title with accent gradient feel -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- App icon placeholder -->
                    <Border Width="32" Height="32" CornerRadius="8"
                            Background="{DynamicResource AccentBrush}"
                            Margin="0,0,12,0">
                        <TextBlock Text="S" FontSize="16" FontWeight="Bold"
                                   Foreground="White"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{x:Static res:Strings.AppName}"
                                   FontSize="18" FontWeight="Bold"
                                   Foreground="{DynamicResource AccentBrush}"/>
                        <TextBlock Text="{x:Static res:Strings.AppSubtitle}"
                                   FontSize="11"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   Margin="0,-2,0,0"/>
                    </StackPanel>
                </StackPanel>

                <!-- Search Bar — centered pill -->
                <views:SearchBar Grid.Column="1" Margin="40,0"
                                 DataContext="{Binding SearchViewModel}"
                                 MaxWidth="500"/>

                <!-- Control buttons — Glass circular -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Notification bell with badge -->
                    <Grid Margin="0,0,6,0">
                        <Button Content="&#x1F514;"
                                Command="{Binding ToggleNotificationCenterCommand}"
                                Style="{DynamicResource IconButtonStyle}"
                                ToolTip="Notifications"/>
                        <!-- Unread badge -->
                        <Border Background="#F44336" CornerRadius="7"
                                MinWidth="14" Height="14"
                                HorizontalAlignment="Right" VerticalAlignment="Top"
                                Margin="0,-2,-2,0"
                                Padding="3,0"
                                IsHitTestVisible="False">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding NotificationCenterViewModel.UnreadCount}" Value="0">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="{Binding NotificationCenterViewModel.UnreadCount}"
                                       Foreground="White" FontSize="9" FontWeight="Bold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </Grid>

                    <Button Content="{Binding CurrentLanguage}"
                            Command="{Binding ToggleLanguageCommand}"
                            Style="{DynamicResource IconButtonStyle}"
                            ToolTip="{x:Static res:Strings.ToggleLanguageTooltip}"
                            Margin="0,0,6,0"/>

                    <Button Content="&#x263C;"
                            Command="{Binding ToggleThemeCommand}"
                            Style="{DynamicResource IconButtonStyle}"
                            ToolTip="{x:Static res:Strings.ToggleThemeTooltip}"
                            Margin="0,0,12,0"/>

                    <!-- Window control buttons -->
                    <Button x:Name="MinimizeBtn" Content="&#x2015;"
                            Click="MinimizeClick"
                            Style="{DynamicResource IconButtonStyle}"
                            ToolTip="Minimize"
                            Width="32" Height="32" FontSize="12"
                            Margin="0,0,4,0"/>
                    <Button x:Name="MaximizeBtn" Content="&#x25A1;"
                            Click="MaximizeClick"
                            Style="{DynamicResource IconButtonStyle}"
                            ToolTip="Maximize"
                            Width="32" Height="32" FontSize="13"
                            Margin="0,0,4,0"/>
                    <Button x:Name="CloseBtn" Content="&#x2715;"
                            Click="CloseClick"
                            ToolTip="Close"
                            Width="32" Height="32" FontSize="12"
                            Cursor="Hand"
                            Foreground="{DynamicResource PrimaryTextBrush}"
                            Background="{DynamicResource GlassFillBrush}"
                            BorderBrush="{DynamicResource GlassBorderBrush}"
                            BorderThickness="1"
                            Padding="0">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="CloseBorder"
                                        Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        CornerRadius="16"
                                        Width="{TemplateBinding Width}"
                                        Height="{TemplateBinding Height}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="CloseBorder" Property="Background" Value="#FFEF4444"/>
                                        <Setter Property="Foreground" Value="White"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ═══════════════════════════════════════════════════════
             MAIN CONTENT AREA — Glass side panels + Map
             ═══════════════════════════════════════════════════════ -->
        <Grid Grid.Row="1" Margin="0,2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280" MinWidth="200"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="320" MinWidth="250"/>
            </Grid.ColumnDefinitions>

            <!-- Left Panel: Glass container with vessel list + filters -->
            <Border Grid.Column="0"
                    Background="{DynamicResource GlassFillBrush}"
                    BorderBrush="{DynamicResource GlassEdgeBrush}"
                    BorderThickness="1"
                    CornerRadius="14,0,0,14"
                    Margin="2,0,0,0">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.12" Color="#000000" Direction="270"/>
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="200"/>
                    </Grid.RowDefinitions>

                    <views:VesselListPanel Grid.Row="0"
                                           DataContext="{Binding VesselListViewModel}"/>

                    <!-- Subtle glass divider instead of splitter -->
                    <Border Grid.Row="1" Height="1"
                            Background="{DynamicResource GlassBorderBrush}"
                            Margin="12,0"/>

                    <views:FilterPanel Grid.Row="2"
                                       DataContext="{Binding FilterViewModel}"/>
                </Grid>
            </Border>

            <!-- Left Splitter — minimal -->
            <GridSplitter Grid.Column="1" Width="6"
                          Background="Transparent"
                          HorizontalAlignment="Center"/>

            <!-- Center: Map (no glass — full content) -->
            <Border Grid.Column="2"
                    CornerRadius="0"
                    Margin="0"
                    ClipToBounds="True">
                <views:MapView DataContext="{Binding MapViewModel}"/>
            </Border>

            <!-- Right Splitter — minimal -->
            <GridSplitter Grid.Column="3" Width="6"
                          Background="Transparent"
                          HorizontalAlignment="Center"/>

            <!-- Right Panel: Glass vessel details or Dashboard -->
            <Border Grid.Column="4"
                    Background="{DynamicResource GlassFillBrush}"
                    BorderBrush="{DynamicResource GlassEdgeBrush}"
                    BorderThickness="1"
                    CornerRadius="0,14,14,0"
                    Margin="0,0,2,0">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.12" Color="#000000" Direction="270"/>
                </Border.Effect>
                <Grid>
                    <!-- Panel selector tabs -->
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Tab Strip -->
                    <Border Grid.Row="0" Background="{DynamicResource GlassFillBrush}"
                            Padding="4,4" Margin="4,4,4,0">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Button Content="&#x26F5;" ToolTip="Vessel Details"
                                    Command="{Binding ShowRightPanelCommand}" CommandParameter="0"
                                    Style="{DynamicResource IconButtonStyle}" FontSize="13" Margin="2,0"/>
                            <Button Content="&#x1F4CA;" ToolTip="Dashboard"
                                    Command="{Binding ShowRightPanelCommand}" CommandParameter="1"
                                    Style="{DynamicResource IconButtonStyle}" FontSize="13" Margin="2,0"/>
                            <Button Content="&#x1F3C6;" ToolTip="Ship Spotter"
                                    Command="{Binding ShowRightPanelCommand}" CommandParameter="2"
                                    Style="{DynamicResource IconButtonStyle}" FontSize="13" Margin="2,0"/>
                            <Button Content="&#x2693;" ToolTip="Port Activity"
                                    Command="{Binding ShowRightPanelCommand}" CommandParameter="3"
                                    Style="{DynamicResource IconButtonStyle}" FontSize="13" Margin="2,0"/>
                            <Button Content="&#x26A1;" ToolTip="Smart Alerts"
                                    Command="{Binding ShowRightPanelCommand}" CommandParameter="4"
                                    Style="{DynamicResource IconButtonStyle}" FontSize="13" Margin="2,0"/>
                            <Button Content="&#x1F30D;" ToolTip="Chokepoints"
                                    Command="{Binding ShowRightPanelCommand}" CommandParameter="5"
                                    Style="{DynamicResource IconButtonStyle}" FontSize="13" Margin="2,0"/>
                            <Button Content="&#x1F4D3;" ToolTip="Journal"
                                    Command="{Binding ShowRightPanelCommand}" CommandParameter="6"
                                    Style="{DynamicResource IconButtonStyle}" FontSize="13" Margin="2,0"/>
                            <Button Content="&#x1F4E6;" ToolTip="Shipments"
                                    Command="{Binding ShowRightPanelCommand}" CommandParameter="7"
                                    Style="{DynamicResource IconButtonStyle}" FontSize="13" Margin="2,0"/>
                            <Button Content="&#x26A0;" ToolTip="Maritime News"
                                    Command="{Binding ShowRightPanelCommand}" CommandParameter="8"
                                    Style="{DynamicResource IconButtonStyle}" FontSize="13" Margin="2,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Panel Content -->
                    <Grid Grid.Row="1">
                        <!-- Vessel Detail (index 0) -->
                        <views:VesselDetailPanel DataContext="{Binding VesselDetailViewModel}">
                            <views:VesselDetailPanel.Style>
                                <Style TargetType="UserControl">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding DataContext.RightPanelIndex, RelativeSource={RelativeSource AncestorType=Window}}" Value="0">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </views:VesselDetailPanel.Style>
                        </views:VesselDetailPanel>

                        <!-- Dashboard (index 1) -->
                        <views:DashboardPanel DataContext="{Binding StatisticsViewModel}">
                            <views:DashboardPanel.Style>
                                <Style TargetType="UserControl">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding DataContext.RightPanelIndex, RelativeSource={RelativeSource AncestorType=Window}}" Value="1">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </views:DashboardPanel.Style>
                        </views:DashboardPanel>

                        <!-- Ship Spotter / Achievements (index 2) -->
                        <views:AchievementPanel DataContext="{Binding AchievementViewModel}">
                            <views:AchievementPanel.Style>
                                <Style TargetType="UserControl">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding DataContext.RightPanelIndex, RelativeSource={RelativeSource AncestorType=Window}}" Value="2">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </views:AchievementPanel.Style>
                        </views:AchievementPanel>

                        <!-- Port Activity (index 3) -->
                        <views:PortDashboardPanel DataContext="{Binding PortDashboardViewModel}">
                            <views:PortDashboardPanel.Style>
                                <Style TargetType="UserControl">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding DataContext.RightPanelIndex, RelativeSource={RelativeSource AncestorType=Window}}" Value="3">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </views:PortDashboardPanel.Style>
                        </views:PortDashboardPanel>

                        <!-- Smart Alerts (index 4) -->
                        <views:AlertRulePanel DataContext="{Binding AlertRuleViewModel}">
                            <views:AlertRulePanel.Style>
                                <Style TargetType="UserControl">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding DataContext.RightPanelIndex, RelativeSource={RelativeSource AncestorType=Window}}" Value="4">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </views:AlertRulePanel.Style>
                        </views:AlertRulePanel>

                        <!-- Chokepoints (index 5) -->
                        <views:ChokepointPanel DataContext="{Binding ChokepointViewModel}">
                            <views:ChokepointPanel.Style>
                                <Style TargetType="UserControl">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding DataContext.RightPanelIndex, RelativeSource={RelativeSource AncestorType=Window}}" Value="5">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </views:ChokepointPanel.Style>
                        </views:ChokepointPanel>

                        <!-- Journal (index 6) -->
                        <views:EncounterJournalPanel DataContext="{Binding EncounterJournalViewModel}">
                            <views:EncounterJournalPanel.Style>
                                <Style TargetType="UserControl">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding DataContext.RightPanelIndex, RelativeSource={RelativeSource AncestorType=Window}}" Value="6">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </views:EncounterJournalPanel.Style>
                        </views:EncounterJournalPanel>

                        <!-- Shipments (index 7) -->
                        <views:ShipmentPanel DataContext="{Binding ShipmentViewModel}">
                            <views:ShipmentPanel.Style>
                                <Style TargetType="UserControl">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding DataContext.RightPanelIndex, RelativeSource={RelativeSource AncestorType=Window}}" Value="7">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </views:ShipmentPanel.Style>
                        </views:ShipmentPanel>

                        <!-- Maritime News (index 8) -->
                        <views:MaritimeNewsPanel DataContext="{Binding MaritimeNewsViewModel}">
                            <views:MaritimeNewsPanel.Style>
                                <Style TargetType="UserControl">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding DataContext.RightPanelIndex, RelativeSource={RelativeSource AncestorType=Window}}" Value="8">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </views:MaritimeNewsPanel.Style>
                        </views:MaritimeNewsPanel>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- ═══════════════════════════════════════════════════════
             STATUS BAR — Floating glass dock
             ═══════════════════════════════════════════════════════ -->
        <Border Grid.Row="2" Style="{DynamicResource StatusBarStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Connection Status — Pulsing indicator -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="0,0,24,0">
                    <Ellipse Width="10" Height="10" Margin="0,0,8,0">
                        <Ellipse.Fill>
                            <SolidColorBrush Color="{Binding ConnectionStatusColor}"/>
                        </Ellipse.Fill>
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Style.Triggers>
                                    <EventTrigger RoutedEvent="Loaded">
                                        <BeginStoryboard>
                                            <Storyboard RepeatBehavior="Forever">
                                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                 From="1" To="0.35" Duration="0:0:1"
                                                                 AutoReverse="True">
                                                    <DoubleAnimation.EasingFunction>
                                                        <SineEase EasingMode="EaseInOut"/>
                                                    </DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <TextBlock Text="{Binding ConnectionStatusText}"
                               Foreground="{DynamicResource PrimaryTextBrush}"
                               FontSize="12" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Vessel Count — with accent highlight -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,0,24,0">
                    <TextBlock Text="{Binding Source={x:Static res:Strings.Ships}, StringFormat='{}{0}: '}"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               FontSize="12" VerticalAlignment="Center"/>
                    <Border Background="{DynamicResource AccentGlowBrush}"
                            CornerRadius="8" Padding="8,2">
                        <TextBlock Text="{Binding VesselCount}"
                                   Foreground="{DynamicResource PrimaryTextBrush}"
                                   FontSize="12" FontWeight="Bold"/>
                    </Border>
                </StackPanel>

                <!-- Area Info -->
                <TextBlock Grid.Column="2"
                           Text="{Binding MapViewModel.AreaStatusText, StringFormat='Area: {0}'}"
                           Foreground="{DynamicResource SecondaryTextBrush}"
                           FontSize="12" VerticalAlignment="Center"/>

                <!-- Start Tracking Button + Dashboard toggle -->
                <StackPanel Grid.Column="3" Orientation="Horizontal">
                    <TextBlock Text="{Binding MessageRateText}"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               FontSize="11" VerticalAlignment="Center"
                               Margin="0,0,16,0"/>
                    <Button Content="{x:Static res:Strings.StartTracking}"
                            Command="{Binding MapViewModel.StartTrackingCommand}"
                            IsEnabled="{Binding HasApiKey}"
                            ToolTip="{Binding StartTrackingTooltip}"
                            Style="{DynamicResource AccentButtonStyle}"
                            FontSize="12" Padding="16,6"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ═══════════════════════════════════════════════════════
             NOTIFICATION CENTER — Slide-out panel overlay
             ═══════════════════════════════════════════════════════ -->
        <Border Grid.Row="0" Grid.RowSpan="3"
                HorizontalAlignment="Right"
                VerticalAlignment="Stretch"
                Width="340"
                Margin="0,60,8,8"
                Visibility="{Binding IsNotificationCenterOpen, Converter={StaticResource BoolToVis}}"
                Background="{DynamicResource GlassFillBrush}"
                BorderBrush="{DynamicResource GlassEdgeBrush}"
                BorderThickness="1"
                CornerRadius="{DynamicResource LargeCornerRadius}"
                Panel.ZIndex="20">
            <Border.Effect>
                <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.3" Color="#000000" Direction="270"/>
            </Border.Effect>
            <views:NotificationCenterPanel DataContext="{Binding NotificationCenterViewModel}"/>
        </Border>

        <!-- ═══════════════════════════════════════════════════════
             NO API KEY BANNER — Centered floating overlay
             ═══════════════════════════════════════════════════════ -->
        <Border Grid.Row="1" VerticalAlignment="Top" HorizontalAlignment="Center"
                Margin="0,14,0,0"
                Visibility="{Binding HasApiKey, Converter={StaticResource InverseBoolToVis}}"
                Background="{DynamicResource GlassFillBrush}"
                BorderBrush="{DynamicResource WarningBrush}"
                BorderThickness="1"
                CornerRadius="{DynamicResource LargeCornerRadius}"
                Padding="22,12"
                Panel.ZIndex="10">
            <Border.Effect>
                <DropShadowEffect BlurRadius="20" ShadowDepth="2" Opacity="0.25" Color="#000000" Direction="270"/>
            </Border.Effect>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#x26A0;" FontSize="15" Margin="0,0,10,0" VerticalAlignment="Center"/>
                <TextBlock Text="{x:Static res:Strings.NoApiKeyWarning}"
                           Foreground="{DynamicResource PrimaryTextBrush}"
                           FontSize="13" VerticalAlignment="Center" Margin="0,0,14,0"/>
                <Button Content="{x:Static res:Strings.AddApiKey}"
                        Command="{Binding OpenApiKeyDialogCommand}"
                        Style="{DynamicResource AccentButtonStyle}"
                        FontSize="12" Padding="14,6"/>
            </StackPanel>
        </Border>

        <!-- ═══════════════════════════════════════════════════════
             NOTIFICATION TOAST — Glass slide-in overlay
             ═══════════════════════════════════════════════════════ -->
        <Border Grid.Row="0" Grid.RowSpan="3"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Margin="0,70,20,0"
                Visibility="{Binding ShowNotification, Converter={StaticResource BoolToVis}}"
                Background="{DynamicResource GlassFillBrush}"
                BorderBrush="{DynamicResource GlassEdgeBrush}"
                BorderThickness="1"
                CornerRadius="{DynamicResource LargeCornerRadius}"
                Padding="18,14"
                MaxWidth="360">
            <Border.Effect>
                <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.25" Color="#000000" Direction="270"/>
            </Border.Effect>
            <Border.RenderTransform>
                <TranslateTransform x:Name="NotificationTranslate"/>
            </Border.RenderTransform>
            <Border.Triggers>
                <EventTrigger RoutedEvent="Border.Loaded">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                             From="0" To="1" Duration="0:0:0.3">
                                <DoubleAnimation.EasingFunction>
                                    <CubicEase EasingMode="EaseOut"/>
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </Border.Triggers>
            <StackPanel>
                <TextBlock Text="{Binding NotificationText}"
                           Foreground="{DynamicResource PrimaryTextBrush}"
                           FontSize="13" TextWrapping="Wrap"/>
                <Button Content="{x:Static res:Strings.Dismiss}" Margin="0,10,0,0"
                        Command="{Binding DismissNotificationCommand}"
                        Style="{DynamicResource GhostButtonStyle}"
                        HorizontalAlignment="Right"
                        FontSize="11" Padding="12,4"/>
            </StackPanel>
        </Border>
    </Grid>

</Window>
