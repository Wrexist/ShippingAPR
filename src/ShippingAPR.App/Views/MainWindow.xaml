<Window x:Class="ShippingAPR.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:ShippingAPR.App.Views"
        Title="ShippingAPR - Real-Time Ship Tracker"
        Width="1400" Height="900"
        MinWidth="1000" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource PrimaryBackgroundBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Top Bar -->
        <Border Grid.Row="0" Background="{DynamicResource SecondaryBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1"
                Padding="12,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- App Title -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="ShippingAPR"
                               FontSize="20" FontWeight="Bold"
                               Foreground="{DynamicResource AccentBrush}"
                               Margin="0,0,8,0"/>
                    <TextBlock Text="Real-Time Ship Tracker"
                               FontSize="14"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Search Bar -->
                <views:SearchBar Grid.Column="1" Margin="24,0"
                                 DataContext="{Binding SearchViewModel}"/>

                <!-- Controls -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Language Toggle -->
                    <Button Content="{Binding CurrentLanguage, StringFormat='{}{0}'}"
                            Command="{Binding ToggleLanguageCommand}"
                            Style="{DynamicResource AccentButtonStyle}"
                            Width="40" Margin="4,0"
                            ToolTip="Toggle EN/SV"/>

                    <!-- Theme Toggle -->
                    <Button Content="T"
                            Command="{Binding ToggleThemeCommand}"
                            Style="{DynamicResource AccentButtonStyle}"
                            Width="40" Margin="4,0"
                            ToolTip="Toggle Dark/Light Theme"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Content Area -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280" MinWidth="200"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="320" MinWidth="250"/>
            </Grid.ColumnDefinitions>

            <!-- Left Panel: Vessel List + Filters -->
            <Grid Grid.Column="0" Background="{DynamicResource SecondaryBackgroundBrush}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="200"/>
                </Grid.RowDefinitions>

                <views:VesselListPanel Grid.Row="0"
                                       DataContext="{Binding VesselListViewModel}"/>

                <GridSplitter Grid.Row="1" Height="4"
                              HorizontalAlignment="Stretch"
                              Background="{DynamicResource BorderBrush}"/>

                <views:FilterPanel Grid.Row="2"
                                   DataContext="{Binding FilterViewModel}"/>
            </Grid>

            <!-- Left Splitter -->
            <GridSplitter Grid.Column="1" Width="4"
                          Background="{DynamicResource BorderBrush}"
                          HorizontalAlignment="Center"/>

            <!-- Center: Map -->
            <views:MapView Grid.Column="2"
                           DataContext="{Binding MapViewModel}"/>

            <!-- Right Splitter -->
            <GridSplitter Grid.Column="3" Width="4"
                          Background="{DynamicResource BorderBrush}"
                          HorizontalAlignment="Center"/>

            <!-- Right Panel: Vessel Details -->
            <views:VesselDetailPanel Grid.Column="4"
                                     DataContext="{Binding VesselDetailViewModel}"
                                     Background="{DynamicResource SecondaryBackgroundBrush}"/>
        </Grid>

        <!-- Status Bar -->
        <Border Grid.Row="2" Style="{DynamicResource StatusBarStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Connection Status -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="0,0,24,0">
                    <Ellipse Width="10" Height="10" Margin="0,0,6,0">
                        <Ellipse.Fill>
                            <SolidColorBrush Color="{Binding ConnectionStatusColor}"/>
                        </Ellipse.Fill>
                    </Ellipse>
                    <TextBlock Text="{Binding ConnectionStatusText}"
                               Foreground="{DynamicResource PrimaryTextBrush}"
                               FontSize="12"/>
                </StackPanel>

                <!-- Vessel Count -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,0,24,0">
                    <TextBlock Text="Ships: "
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               FontSize="12"/>
                    <TextBlock Text="{Binding VesselCount}"
                               Foreground="{DynamicResource PrimaryTextBrush}"
                               FontSize="12" FontWeight="SemiBold"/>
                </StackPanel>

                <!-- Area Info -->
                <TextBlock Grid.Column="2"
                           Text="{Binding MapViewModel.AreaStatusText, StringFormat='Area: {0}'}"
                           Foreground="{DynamicResource SecondaryTextBrush}"
                           FontSize="12"/>

                <!-- Start Tracking Button -->
                <Button Grid.Column="3"
                        Content="Start Tracking"
                        Command="{Binding MapViewModel.StartTrackingCommand}"
                        Style="{DynamicResource AccentButtonStyle}"
                        FontSize="12" Padding="12,4"/>
            </Grid>
        </Border>

        <!-- Notification Toast Overlay -->
        <Border Grid.Row="0" Grid.RowSpan="3"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Margin="0,60,20,0"
                Visibility="{Binding ShowNotification, Converter={StaticResource BoolToVis}}"
                Background="{DynamicResource TertiaryBackgroundBrush}"
                CornerRadius="8"
                Padding="16,12"
                MaxWidth="350">
            <StackPanel>
                <TextBlock Text="{Binding NotificationText}"
                           Foreground="{DynamicResource PrimaryTextBrush}"
                           FontSize="13" TextWrapping="Wrap"/>
                <Button Content="Dismiss" Margin="0,8,0,0"
                        Command="{Binding DismissNotificationCommand}"
                        HorizontalAlignment="Right"
                        FontSize="11"
                        Foreground="{DynamicResource AccentBrush}"
                        Background="Transparent" BorderThickness="0"
                        Cursor="Hand"/>
            </StackPanel>
        </Border>
    </Grid>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>
</Window>
