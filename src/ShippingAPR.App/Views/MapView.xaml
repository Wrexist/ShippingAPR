<UserControl x:Class="ShippingAPR.App.Views.MapView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mapsui="clr-namespace:Mapsui.UI.Wpf;assembly=Mapsui.UI.Wpf"
             xmlns:res="clr-namespace:ShippingAPR.App.Resources">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <local:SelectAreaTextConverter x:Key="SelectAreaText"
                                       xmlns:local="clr-namespace:ShippingAPR.App.Converters"/>
        <local:BoolToOpacityConverter x:Key="BoolToOpacity"
                                      xmlns:local="clr-namespace:ShippingAPR.App.Converters"/>
    </UserControl.Resources>

    <Grid>
        <!-- Map Control -->
        <mapsui:MapControl x:Name="MapControl"/>

        <!-- Vessel Hover Tooltip -->
        <Popup x:Name="VesselTooltip" Placement="Mouse"
               IsOpen="False" AllowsTransparency="True"
               HorizontalOffset="12" VerticalOffset="12"
               IsHitTestVisible="False">
            <Border Background="{DynamicResource GlassFillBrush}"
                    BorderBrush="{DynamicResource GlassEdgeBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="10,8"
                    MaxWidth="220">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.2" Color="#000000"/>
                </Border.Effect>
                <StackPanel>
                    <TextBlock x:Name="TooltipName" FontSize="13" FontWeight="SemiBold"
                               Foreground="{DynamicResource PrimaryTextBrush}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                        <Ellipse x:Name="TooltipTypeIndicator" Width="8" Height="8" Margin="0,0,6,0"/>
                        <TextBlock x:Name="TooltipType" FontSize="11"
                                   Foreground="{DynamicResource SecondaryTextBrush}"/>
                    </StackPanel>
                    <TextBlock x:Name="TooltipSpeed" FontSize="11" Margin="0,2,0,0"
                               Foreground="{DynamicResource SecondaryTextBrush}"/>
                    <TextBlock x:Name="TooltipDestination" FontSize="11" Margin="0,2,0,0"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </Border>
        </Popup>

        <!-- ═══ Top-Left: Area selection + Region buttons ═══ -->
        <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    Margin="14">
            <Button Content="{Binding IsSelectingArea, Converter={StaticResource SelectAreaText}}"
                    Command="{Binding ToggleAreaSelectionCommand}"
                    ToolTip="{x:Static res:Strings.DrawAreaHint}"
                    Style="{DynamicResource AccentButtonStyle}"
                    FontSize="12" Padding="14,8"
                    Margin="0,0,8,0"/>

            <!-- Quick region navigation buttons -->
            <Border Background="{DynamicResource GlassFillBrush}"
                    BorderBrush="{DynamicResource GlassEdgeBrush}"
                    BorderThickness="1"
                    CornerRadius="{DynamicResource PillCornerRadius}"
                    Padding="4,2">
                <StackPanel Orientation="Horizontal">
                    <Button Content="{x:Static res:Strings.Europe}"
                            Command="{Binding NavigateToRegionCommand}"
                            CommandParameter="Europe"
                            Style="{DynamicResource GhostButtonStyle}"
                            FontSize="11" Padding="10,6"/>
                    <Button Content="{x:Static res:Strings.Asia}"
                            Command="{Binding NavigateToRegionCommand}"
                            CommandParameter="Asia"
                            Style="{DynamicResource GhostButtonStyle}"
                            FontSize="11" Padding="10,6"/>
                    <Button Content="{x:Static res:Strings.Americas}"
                            Command="{Binding NavigateToRegionCommand}"
                            CommandParameter="Americas"
                            Style="{DynamicResource GhostButtonStyle}"
                            FontSize="11" Padding="10,6"/>
                    <Button Content="{x:Static res:Strings.Global}"
                            Command="{Binding NavigateToRegionCommand}"
                            CommandParameter="Global"
                            Style="{DynamicResource GhostButtonStyle}"
                            FontSize="11" Padding="10,6"/>
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- ═══ Map Tools — Top-right floating glass toolbar ═══ -->
        <StackPanel HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Margin="0,14,14,0">
            <Border Background="{DynamicResource GlassFillBrush}"
                    BorderBrush="{DynamicResource GlassEdgeBrush}"
                    BorderThickness="1"
                    CornerRadius="{DynamicResource LargeCornerRadius}"
                    Padding="4">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="8" ShadowDepth="1" Opacity="0.15" Color="#000000"/>
                </Border.Effect>
                <StackPanel>
                    <!-- Weather overlay toggle -->
                    <Button Content="&#x26C5;" ToolTip="Weather Overlay"
                            Command="{Binding ToggleWeatherOverlayCommand}"
                            Style="{DynamicResource GhostButtonStyle}"
                            FontSize="14" Width="36" Height="36"
                            Padding="0" HorizontalContentAlignment="Center"
                            Opacity="{Binding ShowWeatherOverlay, Converter={StaticResource BoolToOpacity}}"/>
                    <!-- Heatmap toggle -->
                    <Button Content="&#x1F525;" ToolTip="Traffic Heatmap"
                            Command="{Binding ToggleHeatmapCommand}"
                            Style="{DynamicResource GhostButtonStyle}"
                            FontSize="14" Width="36" Height="36"
                            Padding="0" HorizontalContentAlignment="Center"/>
                    <!-- Distance measurement -->
                    <Button Content="&#x1F4CF;" ToolTip="Measure Distance"
                            Command="{Binding ToggleMeasurementCommand}"
                            Style="{DynamicResource GhostButtonStyle}"
                            FontSize="14" Width="36" Height="36"
                            Padding="0" HorizontalContentAlignment="Center"/>
                    <Border Height="1"
                            Background="{DynamicResource GlassBorderBrush}"
                            Margin="6,2"/>
                    <!-- Map layer selector -->
                    <Button Content="&#x1F5FA;" ToolTip="OpenStreetMap"
                            Command="{Binding SwitchMapLayerCommand}" CommandParameter="OpenStreetMap"
                            Style="{DynamicResource GhostButtonStyle}"
                            FontSize="14" Width="36" Height="36"
                            Padding="0" HorizontalContentAlignment="Center"/>
                    <Button Content="&#x1F6F0;" ToolTip="Satellite View"
                            Command="{Binding SwitchMapLayerCommand}" CommandParameter="Satellite"
                            Style="{DynamicResource GhostButtonStyle}"
                            FontSize="14" Width="36" Height="36"
                            Padding="0" HorizontalContentAlignment="Center"/>
                    <Button Content="&#x2693;" ToolTip="Nautical Chart (OpenSeaMap overlay)"
                            Command="{Binding SwitchMapLayerCommand}" CommandParameter="SeaMap"
                            Style="{DynamicResource GhostButtonStyle}"
                            FontSize="14" Width="36" Height="36"
                            Padding="0" HorizontalContentAlignment="Center"/>
                    <Button Content="&#x1F30A;" ToolTip="Depth / Bathymetry"
                            Command="{Binding SwitchMapLayerCommand}" CommandParameter="Depth"
                            Style="{DynamicResource GhostButtonStyle}"
                            FontSize="14" Width="36" Height="36"
                            Padding="0" HorizontalContentAlignment="Center"/>
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- ═══ Zoom Controls — Bottom-left floating glass ═══ -->
        <StackPanel VerticalAlignment="Bottom"
                    HorizontalAlignment="Left"
                    Margin="14,0,0,14">
            <Border Background="{DynamicResource GlassFillBrush}"
                    BorderBrush="{DynamicResource GlassEdgeBrush}"
                    BorderThickness="1"
                    CornerRadius="{DynamicResource LargeCornerRadius}"
                    Padding="4">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="8" ShadowDepth="1" Opacity="0.15" Color="#000000"/>
                </Border.Effect>
                <StackPanel>
                    <Button Content="+"
                            Command="{Binding ZoomInCommand}"
                            ToolTip="{x:Static res:Strings.ZoomIn}"
                            Style="{DynamicResource GhostButtonStyle}"
                            FontSize="18" FontWeight="Bold"
                            Width="36" Height="36"
                            Padding="0" HorizontalContentAlignment="Center"/>
                    <Border Height="1"
                            Background="{DynamicResource GlassBorderBrush}"
                            Margin="6,0"/>
                    <Button Content="-"
                            Command="{Binding ZoomOutCommand}"
                            ToolTip="{x:Static res:Strings.ZoomOut}"
                            Style="{DynamicResource GhostButtonStyle}"
                            FontSize="18" FontWeight="Bold"
                            Width="36" Height="36"
                            Padding="0" HorizontalContentAlignment="Center"/>
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- ═══ Measurement Display — Bottom-center floating ═══ -->
        <Border HorizontalAlignment="Center"
                VerticalAlignment="Bottom"
                Margin="0,0,0,14"
                Visibility="{Binding IsMeasuring, Converter={StaticResource BoolToVis}}"
                Background="{DynamicResource GlassFillBrush}"
                BorderBrush="{DynamicResource GlassEdgeBrush}"
                BorderThickness="1"
                CornerRadius="{DynamicResource PillCornerRadius}"
                Padding="18,10">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#x1F4CF;" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding MeasurementText}" FontSize="14" FontWeight="SemiBold"
                           Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- ═══ Playback Controls — Bottom-center ═══ -->
        <Border HorizontalAlignment="Center"
                VerticalAlignment="Bottom"
                Margin="0,0,0,56"
                Visibility="{Binding IsPlaybackMode, Converter={StaticResource BoolToVis}}"
                Background="{DynamicResource GlassFillBrush}"
                BorderBrush="{DynamicResource GlassEdgeBrush}"
                BorderThickness="1"
                CornerRadius="{DynamicResource PillCornerRadius}"
                Padding="18,10"
                MinWidth="300">
            <StackPanel>
                <TextBlock Text="{Binding PlaybackTimeText}" FontSize="12"
                           Foreground="{DynamicResource SecondaryTextBrush}"
                           HorizontalAlignment="Center" Margin="0,0,0,6"/>
                <Slider Value="{Binding PlaybackPosition}"
                        Minimum="0" Maximum="1"
                        Style="{DynamicResource GlassSliderStyle}"
                        Width="260"/>
            </StackPanel>
        </Border>

        <!-- ═══ Selection hint — Glass floating banner ═══ -->
        <Border HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Margin="0,16,0,0"
                Visibility="{Binding IsSelectingArea, Converter={StaticResource BoolToVis}}"
                Background="{DynamicResource GlassFillBrush}"
                BorderBrush="{DynamicResource GlassEdgeBrush}"
                BorderThickness="1"
                CornerRadius="{DynamicResource PillCornerRadius}"
                Padding="18,10">
            <Border.Effect>
                <DropShadowEffect BlurRadius="16" ShadowDepth="2" Opacity="0.2" Color="#000000"/>
            </Border.Effect>
            <Border.Triggers>
                <EventTrigger RoutedEvent="Border.Loaded">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                             From="0" To="1" Duration="0:0:0.4">
                                <DoubleAnimation.EasingFunction>
                                    <CubicEase EasingMode="EaseOut"/>
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </Border.Triggers>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#x1F4CD;" FontSize="14" Margin="0,0,8,0"
                           VerticalAlignment="Center"/>
                <TextBlock Text="{x:Static res:Strings.AreaSelectionHint}"
                           FontSize="13"
                           Foreground="{DynamicResource PrimaryTextBrush}"
                           VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- ═══ Map Legend — Glass card overlay ═══ -->
        <Border HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Margin="14"
                Background="{DynamicResource GlassFillBrush}"
                BorderBrush="{DynamicResource GlassEdgeBrush}"
                BorderThickness="1"
                CornerRadius="{DynamicResource LargeCornerRadius}"
                Padding="14,12">
            <Border.Effect>
                <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.15" Color="#000000"/>
            </Border.Effect>
            <StackPanel>
                <TextBlock Text="{x:Static res:Strings.Legend}" FontWeight="SemiBold"
                           Foreground="{DynamicResource PrimaryTextBrush}"
                           FontSize="12" Margin="0,0,0,8"/>

                <!-- Cargo -->
                <StackPanel Orientation="Horizontal" Margin="0,3">
                    <Ellipse Width="10" Height="10" Margin="0,0,8,0">
                        <Ellipse.Fill>
                            <SolidColorBrush Color="{DynamicResource CargoColor}"/>
                        </Ellipse.Fill>
                        <Ellipse.Effect>
                            <DropShadowEffect BlurRadius="4" ShadowDepth="0" Opacity="0.4"
                                              Color="{DynamicResource CargoColor}"/>
                        </Ellipse.Effect>
                    </Ellipse>
                    <TextBlock Text="{x:Static res:Strings.Cargo}" FontSize="11"
                               Foreground="{DynamicResource SecondaryTextBrush}"/>
                </StackPanel>

                <!-- Tanker -->
                <StackPanel Orientation="Horizontal" Margin="0,3">
                    <Ellipse Width="10" Height="10" Margin="0,0,8,0">
                        <Ellipse.Fill>
                            <SolidColorBrush Color="{DynamicResource TankerColor}"/>
                        </Ellipse.Fill>
                        <Ellipse.Effect>
                            <DropShadowEffect BlurRadius="4" ShadowDepth="0" Opacity="0.4"
                                              Color="{DynamicResource TankerColor}"/>
                        </Ellipse.Effect>
                    </Ellipse>
                    <TextBlock Text="{x:Static res:Strings.Tanker}" FontSize="11"
                               Foreground="{DynamicResource SecondaryTextBrush}"/>
                </StackPanel>

                <!-- Passenger -->
                <StackPanel Orientation="Horizontal" Margin="0,3">
                    <Ellipse Width="10" Height="10" Margin="0,0,8,0">
                        <Ellipse.Fill>
                            <SolidColorBrush Color="{DynamicResource PassengerColor}"/>
                        </Ellipse.Fill>
                        <Ellipse.Effect>
                            <DropShadowEffect BlurRadius="4" ShadowDepth="0" Opacity="0.4"
                                              Color="{DynamicResource PassengerColor}"/>
                        </Ellipse.Effect>
                    </Ellipse>
                    <TextBlock Text="{x:Static res:Strings.Passenger}" FontSize="11"
                               Foreground="{DynamicResource SecondaryTextBrush}"/>
                </StackPanel>

                <!-- Fishing -->
                <StackPanel Orientation="Horizontal" Margin="0,3">
                    <Ellipse Width="10" Height="10" Margin="0,0,8,0">
                        <Ellipse.Fill>
                            <SolidColorBrush Color="{DynamicResource FishingColor}"/>
                        </Ellipse.Fill>
                        <Ellipse.Effect>
                            <DropShadowEffect BlurRadius="4" ShadowDepth="0" Opacity="0.4"
                                              Color="{DynamicResource FishingColor}"/>
                        </Ellipse.Effect>
                    </Ellipse>
                    <TextBlock Text="{x:Static res:Strings.Fishing}" FontSize="11"
                               Foreground="{DynamicResource SecondaryTextBrush}"/>
                </StackPanel>

                <!-- Tug/Pilot -->
                <StackPanel Orientation="Horizontal" Margin="0,3">
                    <Ellipse Width="10" Height="10" Margin="0,0,8,0">
                        <Ellipse.Fill>
                            <SolidColorBrush Color="{DynamicResource TugColor}"/>
                        </Ellipse.Fill>
                        <Ellipse.Effect>
                            <DropShadowEffect BlurRadius="4" ShadowDepth="0" Opacity="0.4"
                                              Color="{DynamicResource TugColor}"/>
                        </Ellipse.Effect>
                    </Ellipse>
                    <TextBlock Text="{x:Static res:Strings.TugPilotShort}" FontSize="11"
                               Foreground="{DynamicResource SecondaryTextBrush}"/>
                </StackPanel>

                <!-- Other -->
                <StackPanel Orientation="Horizontal" Margin="0,3">
                    <Ellipse Width="10" Height="10" Margin="0,0,8,0">
                        <Ellipse.Fill>
                            <SolidColorBrush Color="{DynamicResource DefaultVesselColor}"/>
                        </Ellipse.Fill>
                    </Ellipse>
                    <TextBlock Text="{x:Static res:Strings.Other}" FontSize="11"
                               Foreground="{DynamicResource SecondaryTextBrush}"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>

</UserControl>
