<UserControl x:Class="ShippingAPR.App.Views.MapView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mapsui="clr-namespace:Mapsui.UI.Wpf;assembly=Mapsui.UI.Wpf">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <local:SelectAreaTextConverter x:Key="SelectAreaText"
                                       xmlns:local="clr-namespace:ShippingAPR.App.Converters"/>
    </UserControl.Resources>

    <Grid>
        <!-- Map Control -->
        <mapsui:MapControl x:Name="MapControl"/>

        <!-- ═══ Top-Left: Area selection + Region buttons ═══ -->
        <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    Margin="14">
            <Button Content="{Binding IsSelectingArea, Converter={StaticResource SelectAreaText}}"
                    Command="{Binding ToggleAreaSelectionCommand}"
                    ToolTip="Define the geographic area to track ships in"
                    Style="{DynamicResource AccentButtonStyle}"
                    FontSize="12" Padding="14,8"
                    Margin="0,0,8,0"/>

            <!-- Quick region navigation buttons -->
            <Border Background="{DynamicResource GlassFillBrush}"
                    BorderBrush="{DynamicResource GlassEdgeBrush}"
                    BorderThickness="1"
                    CornerRadius="{DynamicResource PillCornerRadius}"
                    Padding="4,2">
                <StackPanel Orientation="Horizontal">
                    <Button Content="Europe"
                            Command="{Binding NavigateToRegionCommand}"
                            CommandParameter="Europe"
                            Style="{DynamicResource GhostButtonStyle}"
                            FontSize="11" Padding="10,6"/>
                    <Button Content="Asia"
                            Command="{Binding NavigateToRegionCommand}"
                            CommandParameter="Asia"
                            Style="{DynamicResource GhostButtonStyle}"
                            FontSize="11" Padding="10,6"/>
                    <Button Content="Americas"
                            Command="{Binding NavigateToRegionCommand}"
                            CommandParameter="Americas"
                            Style="{DynamicResource GhostButtonStyle}"
                            FontSize="11" Padding="10,6"/>
                    <Button Content="Global"
                            Command="{Binding NavigateToRegionCommand}"
                            CommandParameter="Global"
                            Style="{DynamicResource GhostButtonStyle}"
                            FontSize="11" Padding="10,6"/>
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- ═══ Zoom Controls — Bottom-left floating glass ═══ -->
        <StackPanel VerticalAlignment="Bottom"
                    HorizontalAlignment="Left"
                    Margin="14,0,0,14">
            <Border Background="{DynamicResource GlassFillBrush}"
                    BorderBrush="{DynamicResource GlassEdgeBrush}"
                    BorderThickness="1"
                    CornerRadius="{DynamicResource LargeCornerRadius}"
                    Padding="4">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="8" ShadowDepth="1" Opacity="0.15" Color="#000000"/>
                </Border.Effect>
                <StackPanel>
                    <Button Content="+"
                            Command="{Binding ZoomInCommand}"
                            Style="{DynamicResource GhostButtonStyle}"
                            FontSize="18" FontWeight="Bold"
                            Width="36" Height="36"
                            Padding="0" HorizontalContentAlignment="Center"/>
                    <Border Height="1"
                            Background="{DynamicResource GlassBorderBrush}"
                            Margin="6,0"/>
                    <Button Content="-"
                            Command="{Binding ZoomOutCommand}"
                            Style="{DynamicResource GhostButtonStyle}"
                            FontSize="18" FontWeight="Bold"
                            Width="36" Height="36"
                            Padding="0" HorizontalContentAlignment="Center"/>
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- ═══ Selection hint — Glass floating banner ═══ -->
        <Border HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Margin="0,16,0,0"
                Visibility="{Binding IsSelectingArea, Converter={StaticResource BoolToVis}}"
                Background="{DynamicResource GlassFillBrush}"
                BorderBrush="{DynamicResource GlassEdgeBrush}"
                BorderThickness="1"
                CornerRadius="{DynamicResource PillCornerRadius}"
                Padding="18,10">
            <Border.Effect>
                <DropShadowEffect BlurRadius="16" ShadowDepth="2" Opacity="0.2" Color="#000000"/>
            </Border.Effect>
            <Border.Triggers>
                <EventTrigger RoutedEvent="Border.Loaded">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                             From="0" To="1" Duration="0:0:0.4">
                                <DoubleAnimation.EasingFunction>
                                    <CubicEase EasingMode="EaseOut"/>
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </Border.Triggers>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#x1F4CD;" FontSize="14" Margin="0,0,8,0"
                           VerticalAlignment="Center"/>
                <TextBlock Text="Click two points on the map to define tracking area"
                           FontSize="13"
                           Foreground="{DynamicResource PrimaryTextBrush}"
                           VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- ═══ Map Legend — Glass card overlay ═══ -->
        <Border HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Margin="14"
                Background="{DynamicResource GlassFillBrush}"
                BorderBrush="{DynamicResource GlassEdgeBrush}"
                BorderThickness="1"
                CornerRadius="{DynamicResource LargeCornerRadius}"
                Padding="14,12">
            <Border.Effect>
                <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.15" Color="#000000"/>
            </Border.Effect>
            <StackPanel>
                <TextBlock Text="Legend" FontWeight="SemiBold"
                           Foreground="{DynamicResource PrimaryTextBrush}"
                           FontSize="12" Margin="0,0,0,8"/>

                <!-- Cargo -->
                <StackPanel Orientation="Horizontal" Margin="0,3">
                    <Ellipse Width="10" Height="10" Margin="0,0,8,0">
                        <Ellipse.Fill>
                            <SolidColorBrush Color="{DynamicResource CargoColor}"/>
                        </Ellipse.Fill>
                        <Ellipse.Effect>
                            <DropShadowEffect BlurRadius="4" ShadowDepth="0" Opacity="0.4"
                                              Color="{DynamicResource CargoColor}"/>
                        </Ellipse.Effect>
                    </Ellipse>
                    <TextBlock Text="Cargo" FontSize="11"
                               Foreground="{DynamicResource SecondaryTextBrush}"/>
                </StackPanel>

                <!-- Tanker -->
                <StackPanel Orientation="Horizontal" Margin="0,3">
                    <Ellipse Width="10" Height="10" Margin="0,0,8,0">
                        <Ellipse.Fill>
                            <SolidColorBrush Color="{DynamicResource TankerColor}"/>
                        </Ellipse.Fill>
                        <Ellipse.Effect>
                            <DropShadowEffect BlurRadius="4" ShadowDepth="0" Opacity="0.4"
                                              Color="{DynamicResource TankerColor}"/>
                        </Ellipse.Effect>
                    </Ellipse>
                    <TextBlock Text="Tanker" FontSize="11"
                               Foreground="{DynamicResource SecondaryTextBrush}"/>
                </StackPanel>

                <!-- Passenger -->
                <StackPanel Orientation="Horizontal" Margin="0,3">
                    <Ellipse Width="10" Height="10" Margin="0,0,8,0">
                        <Ellipse.Fill>
                            <SolidColorBrush Color="{DynamicResource PassengerColor}"/>
                        </Ellipse.Fill>
                        <Ellipse.Effect>
                            <DropShadowEffect BlurRadius="4" ShadowDepth="0" Opacity="0.4"
                                              Color="{DynamicResource PassengerColor}"/>
                        </Ellipse.Effect>
                    </Ellipse>
                    <TextBlock Text="Passenger" FontSize="11"
                               Foreground="{DynamicResource SecondaryTextBrush}"/>
                </StackPanel>

                <!-- Fishing -->
                <StackPanel Orientation="Horizontal" Margin="0,3">
                    <Ellipse Width="10" Height="10" Margin="0,0,8,0">
                        <Ellipse.Fill>
                            <SolidColorBrush Color="{DynamicResource FishingColor}"/>
                        </Ellipse.Fill>
                        <Ellipse.Effect>
                            <DropShadowEffect BlurRadius="4" ShadowDepth="0" Opacity="0.4"
                                              Color="{DynamicResource FishingColor}"/>
                        </Ellipse.Effect>
                    </Ellipse>
                    <TextBlock Text="Fishing" FontSize="11"
                               Foreground="{DynamicResource SecondaryTextBrush}"/>
                </StackPanel>

                <!-- Tug/Pilot -->
                <StackPanel Orientation="Horizontal" Margin="0,3">
                    <Ellipse Width="10" Height="10" Margin="0,0,8,0">
                        <Ellipse.Fill>
                            <SolidColorBrush Color="{DynamicResource TugColor}"/>
                        </Ellipse.Fill>
                        <Ellipse.Effect>
                            <DropShadowEffect BlurRadius="4" ShadowDepth="0" Opacity="0.4"
                                              Color="{DynamicResource TugColor}"/>
                        </Ellipse.Effect>
                    </Ellipse>
                    <TextBlock Text="Tug/Pilot" FontSize="11"
                               Foreground="{DynamicResource SecondaryTextBrush}"/>
                </StackPanel>

                <!-- Other -->
                <StackPanel Orientation="Horizontal" Margin="0,3">
                    <Ellipse Width="10" Height="10" Margin="0,0,8,0">
                        <Ellipse.Fill>
                            <SolidColorBrush Color="{DynamicResource DefaultVesselColor}"/>
                        </Ellipse.Fill>
                    </Ellipse>
                    <TextBlock Text="Other" FontSize="11"
                               Foreground="{DynamicResource SecondaryTextBrush}"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>

</UserControl>
