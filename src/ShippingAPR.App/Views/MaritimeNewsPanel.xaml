<UserControl x:Class="ShippingAPR.App.Views.MaritimeNewsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:res="clr-namespace:ShippingAPR.App.Resources">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="12,8,12,4">
            <TextBlock Text="{x:Static res:Strings.MaritimeNews}" FontSize="16" FontWeight="Bold"
                       Foreground="{DynamicResource PrimaryTextBrush}"/>
            <TextBlock Text="{x:Static res:Strings.MaritimeNewsSubtitle}"
                       Style="{DynamicResource SubTextStyle}" FontSize="11" Opacity="0.7"/>
        </StackPanel>

        <!-- Alert counters -->
        <Border Grid.Row="1" Style="{DynamicResource CardStyle}" Margin="12,4,12,4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                    <TextBlock Text="{Binding ActiveIncidentCount}" FontSize="18" FontWeight="Bold"
                               Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center"/>
                    <TextBlock Text="{x:Static res:Strings.Active}" Style="{DynamicResource SubTextStyle}"
                               FontSize="9" HorizontalAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                    <TextBlock Text="{Binding WarningCount}" FontSize="18" FontWeight="Bold"
                               Foreground="#FB923C" HorizontalAlignment="Center"/>
                    <TextBlock Text="{x:Static res:Strings.Warnings}" Style="{DynamicResource SubTextStyle}"
                               FontSize="9" HorizontalAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                    <TextBlock Text="{Binding CriticalCount}" FontSize="18" FontWeight="Bold"
                               Foreground="#EF4444" HorizontalAlignment="Center"/>
                    <TextBlock Text="{x:Static res:Strings.Critical}" Style="{DynamicResource SubTextStyle}"
                               FontSize="9" HorizontalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Category filter -->
        <Border Grid.Row="2" Margin="12,4,12,4" Background="{DynamicResource GlassFillBrush}"
                CornerRadius="8" Padding="4,3">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button Content="{x:Static res:Strings.CategoryAll}" Command="{Binding FilterCategoryCommand}" CommandParameter="All"
                        Style="{DynamicResource GhostButtonStyle}" FontSize="10" Padding="8,2" Margin="1,0"/>
                <Button Content="{x:Static res:Strings.CategorySecurity}" Command="{Binding FilterCategoryCommand}" CommandParameter="SecurityAlert"
                        Style="{DynamicResource GhostButtonStyle}" FontSize="10" Padding="8,2" Margin="1,0"/>
                <Button Content="{x:Static res:Strings.CategoryPiracy}" Command="{Binding FilterCategoryCommand}" CommandParameter="Piracy"
                        Style="{DynamicResource GhostButtonStyle}" FontSize="10" Padding="8,2" Margin="1,0"/>
                <Button Content="{x:Static res:Strings.CategoryWeather}" Command="{Binding FilterCategoryCommand}" CommandParameter="Weather"
                        Style="{DynamicResource GhostButtonStyle}" FontSize="10" Padding="8,2" Margin="1,0"/>
                <Button Content="{x:Static res:Strings.CategoryNav}" Command="{Binding FilterCategoryCommand}" CommandParameter="NavigationalWarning"
                        Style="{DynamicResource GhostButtonStyle}" FontSize="10" Padding="8,2" Margin="1,0"/>
            </StackPanel>
        </Border>

        <!-- Incident list -->
        <ListBox Grid.Row="3" ItemsSource="{Binding Incidents}"
                 Background="Transparent" BorderThickness="0"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 Margin="8,0">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Setter Property="Padding" Value="0"/>
                    <Setter Property="Margin" Value="0,2"/>
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <ContentPresenter/>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Style="{DynamicResource CardStyle}" Padding="10,8" Margin="4,0">
                        <StackPanel>
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Width="4" CornerRadius="2" Margin="0,0,8,0">
                                    <Border.Background>
                                        <SolidColorBrush Color="{Binding SeverityColor}"/>
                                    </Border.Background>
                                </Border>
                                <TextBlock Grid.Column="1" Text="{Binding Title}" FontWeight="SemiBold"
                                           FontSize="12" TextWrapping="Wrap"
                                           Foreground="{DynamicResource PrimaryTextBrush}"/>
                                <TextBlock Grid.Column="2" Text="{Binding TimeText}"
                                           Style="{DynamicResource SubTextStyle}" FontSize="9"
                                           VerticalAlignment="Top"/>
                            </Grid>

                            <TextBlock Text="{Binding Description}" TextWrapping="Wrap" FontSize="11"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       MaxHeight="40" TextTrimming="CharacterEllipsis"
                                       Margin="12,0,0,4"/>

                            <StackPanel Orientation="Horizontal" Margin="12,0,0,0">
                                <Border CornerRadius="4" Padding="6,1" Margin="0,0,6,0"
                                        Background="{DynamicResource GlassFillBrush}">
                                    <TextBlock Text="{Binding CategoryText}" FontSize="9"
                                               Foreground="{DynamicResource SecondaryTextBrush}"/>
                                </Border>
                                <Border CornerRadius="4" Padding="6,1" Margin="0,0,6,0">
                                    <Border.Background>
                                        <SolidColorBrush Color="{Binding SeverityColor}" Opacity="0.2"/>
                                    </Border.Background>
                                    <TextBlock Text="{Binding SeverityText}" FontSize="9">
                                        <TextBlock.Foreground>
                                            <SolidColorBrush Color="{Binding SeverityColor}"/>
                                        </TextBlock.Foreground>
                                    </TextBlock>
                                </Border>
                                <TextBlock Text="{Binding SourceText}" FontSize="9"
                                           Foreground="{DynamicResource SecondaryTextBrush}" Opacity="0.6"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</UserControl>
