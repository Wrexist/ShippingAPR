<UserControl x:Class="ShippingAPR.App.Views.FilterPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:res="clr-namespace:ShippingAPR.App.Resources">
    <Grid Margin="14,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Grid.Row="0" Text="{x:Static res:Strings.Filters}"
                   Style="{DynamicResource HeaderTextStyle}"
                   Margin="0,0,0,12"/>

        <!-- Vessel Type Filters — Toggle switches -->
        <StackPanel Grid.Row="1">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                <Border Width="3" Height="12" CornerRadius="2"
                        Background="{DynamicResource AccentBrush}"
                        Margin="0,0,8,0"/>
                <TextBlock Text="{x:Static res:Strings.VesselTypes}"
                           Style="{DynamicResource SubTextStyle}"
                           FontWeight="Bold" FontSize="10"/>
            </StackPanel>

            <CheckBox Content="{x:Static res:Strings.Cargo}" IsChecked="{Binding ShowCargo}"
                      Style="{DynamicResource GlassToggleStyle}"/>
            <CheckBox Content="{x:Static res:Strings.Tanker}" IsChecked="{Binding ShowTanker}"
                      Style="{DynamicResource GlassToggleStyle}"/>
            <CheckBox Content="{x:Static res:Strings.Passenger}" IsChecked="{Binding ShowPassenger}"
                      Style="{DynamicResource GlassToggleStyle}"/>
            <CheckBox Content="{x:Static res:Strings.Fishing}" IsChecked="{Binding ShowFishing}"
                      Style="{DynamicResource GlassToggleStyle}"/>
            <CheckBox Content="{x:Static res:Strings.TugPilot}" IsChecked="{Binding ShowTugPilot}"
                      Style="{DynamicResource GlassToggleStyle}"/>
            <CheckBox Content="{x:Static res:Strings.Other}" IsChecked="{Binding ShowOther}"
                      Style="{DynamicResource GlassToggleStyle}"/>
        </StackPanel>

        <!-- Advanced Filters -->
        <StackPanel Grid.Row="2" Margin="0,10,0,0">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                <Border Width="3" Height="12" CornerRadius="2"
                        Background="{DynamicResource SuccessBrush}"
                        Margin="0,0,8,0"/>
                <TextBlock Text="ADVANCED FILTERS"
                           Style="{DynamicResource SubTextStyle}"
                           FontWeight="Bold" FontSize="10"/>
            </StackPanel>

            <!-- Destination filter -->
            <TextBlock Text="Destination" Style="{DynamicResource SubTextStyle}" FontSize="11" Margin="0,0,0,3"/>
            <Border Background="{DynamicResource GlassFillBrush}"
                    BorderBrush="{DynamicResource GlassBorderBrush}"
                    BorderThickness="1" CornerRadius="6" Margin="0,0,0,8">
                <TextBox Text="{Binding DestinationFilter, UpdateSourceTrigger=PropertyChanged}"
                         Background="Transparent"
                         Foreground="{DynamicResource PrimaryTextBrush}"
                         BorderThickness="0" Padding="8,5" FontSize="12"/>
            </Border>

            <!-- Flag filter -->
            <TextBlock Text="Flag (country code)" Style="{DynamicResource SubTextStyle}" FontSize="11" Margin="0,0,0,3"/>
            <Border Background="{DynamicResource GlassFillBrush}"
                    BorderBrush="{DynamicResource GlassBorderBrush}"
                    BorderThickness="1" CornerRadius="6" Margin="0,0,0,8">
                <TextBox Text="{Binding FlagFilter, UpdateSourceTrigger=PropertyChanged}"
                         Background="Transparent"
                         Foreground="{DynamicResource PrimaryTextBrush}"
                         BorderThickness="0" Padding="8,5" FontSize="12"
                         MaxLength="3"/>
            </Border>
        </StackPanel>

        <!-- Speed Range — Glass slider -->
        <StackPanel Grid.Row="3" Margin="0,10,0,0">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                <Border Width="3" Height="12" CornerRadius="2"
                        Background="{DynamicResource WarningBrush}"
                        Margin="0,0,8,0"/>
                <TextBlock Text="{x:Static res:Strings.SpeedRange}"
                           Style="{DynamicResource SubTextStyle}"
                           FontWeight="Bold" FontSize="10"/>
            </StackPanel>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Slider Grid.Column="0"
                        Minimum="0" Maximum="50"
                        Value="{Binding MaxSpeed}"
                        TickFrequency="5" IsSnapToTickEnabled="True"
                        Style="{DynamicResource GlassSliderStyle}"/>
                <Border Grid.Column="1"
                        Background="{DynamicResource GlassFillBrush}"
                        CornerRadius="6" Padding="8,3"
                        Margin="8,0,0,0"
                        VerticalAlignment="Center">
                    <TextBlock Text="{Binding MaxSpeed, StringFormat='{}{0:F0} kn'}"
                               Style="{DynamicResource SubTextStyle}"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource PrimaryTextBrush}"/>
                </Border>
            </Grid>
        </StackPanel>
    </Grid>
</UserControl>
