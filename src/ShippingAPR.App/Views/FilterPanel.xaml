<UserControl x:Class="ShippingAPR.App.Views.FilterPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Padding="12"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="0,1,0,0">
        <StackPanel>
            <TextBlock Text="Filters" Style="{DynamicResource HeaderTextStyle}"
                       Margin="0,0,0,10"/>

            <!-- Vessel Type Filters -->
            <TextBlock Text="VESSEL TYPES" Style="{DynamicResource SubTextStyle}"
                       FontWeight="Bold" Margin="0,0,0,6"/>
            <CheckBox Content="Cargo" IsChecked="{Binding ShowCargo}"
                      Foreground="{DynamicResource PrimaryTextBrush}"
                      Margin="0,2"/>
            <CheckBox Content="Tanker" IsChecked="{Binding ShowTanker}"
                      Foreground="{DynamicResource PrimaryTextBrush}"
                      Margin="0,2"/>
            <CheckBox Content="Passenger" IsChecked="{Binding ShowPassenger}"
                      Foreground="{DynamicResource PrimaryTextBrush}"
                      Margin="0,2"/>
            <CheckBox Content="Fishing" IsChecked="{Binding ShowFishing}"
                      Foreground="{DynamicResource PrimaryTextBrush}"
                      Margin="0,2"/>
            <CheckBox Content="Tug / Pilot" IsChecked="{Binding ShowTugPilot}"
                      Foreground="{DynamicResource PrimaryTextBrush}"
                      Margin="0,2"/>
            <CheckBox Content="Other" IsChecked="{Binding ShowOther}"
                      Foreground="{DynamicResource PrimaryTextBrush}"
                      Margin="0,2"/>

            <!-- Speed Range -->
            <TextBlock Text="SPEED RANGE" Style="{DynamicResource SubTextStyle}"
                       FontWeight="Bold" Margin="0,12,0,6"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Slider Grid.Column="0"
                        Minimum="0" Maximum="50"
                        Value="{Binding MaxSpeed}"
                        TickFrequency="5" IsSnapToTickEnabled="True"/>
                <TextBlock Grid.Column="1"
                           Text="{Binding MaxSpeed, StringFormat='{}{0:F0} kn'}"
                           Style="{DynamicResource SubTextStyle}"
                           Margin="8,0,0,0"
                           VerticalAlignment="Center"/>
            </Grid>
        </StackPanel>
    </Border>
</UserControl>
