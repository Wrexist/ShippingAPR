<Window x:Class="ShippingAPR.App.Views.SettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:res="clr-namespace:ShippingAPR.App.Resources"
        xmlns:enums="clr-namespace:ShippingAPR.Core.Enums;assembly=ShippingAPR.Core"
        Title="{x:Static res:Strings.Settings}"
        Width="520" Height="600"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent">

    <Border Margin="16">
        <Border.Effect>
            <DropShadowEffect BlurRadius="32" ShadowDepth="0" Opacity="0.35"
                              Color="{DynamicResource AccentColor}"/>
        </Border.Effect>

        <Border Background="{DynamicResource PrimaryBackgroundBrush}"
                CornerRadius="16"
                BorderThickness="1"
                BorderBrush="{DynamicResource GlassEdgeBrush}"
                Padding="32">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Header -->
                <StackPanel Grid.Row="0" Margin="0,0,0,20">
                    <TextBlock Text="{x:Static res:Strings.Settings}"
                               FontSize="22" FontWeight="Bold"
                               Foreground="{DynamicResource PrimaryTextBrush}"/>
                    <TextBlock Text="{x:Static res:Strings.SettingsSubtitle}"
                               FontSize="13"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               Margin="0,4,0,0"/>
                </StackPanel>

                <!-- Settings Content -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel>

                        <!-- Provider Selection -->
                        <TextBlock Text="{x:Static res:Strings.DataProvider}" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,8"/>

                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition/>
                                <RowDefinition/>
                            </Grid.RowDefinitions>

                            <TextBlock Text="{x:Static res:Strings.ActiveProvider}" FontSize="13"
                                       Foreground="{DynamicResource PrimaryTextBrush}"
                                       VerticalAlignment="Center" Margin="0,0,0,6"/>
                            <ComboBox Grid.Column="1"
                                      ItemsSource="{Binding AvailableProviders}"
                                      SelectedItem="{Binding ActiveProvider}"
                                      Margin="0,0,0,6"/>

                            <TextBlock Grid.Row="1" Text="{x:Static res:Strings.FallbackProvider}" FontSize="13"
                                       Foreground="{DynamicResource PrimaryTextBrush}"
                                       VerticalAlignment="Center"/>
                            <ComboBox Grid.Row="1" Grid.Column="1"
                                      ItemsSource="{Binding FallbackOptions}"
                                      SelectedItem="{Binding FallbackProvider}"/>
                        </Grid>

                        <!-- Poll intervals -->
                        <Grid Margin="0,0,0,20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition/>
                                <RowDefinition/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="{x:Static res:Strings.DatalasticPoll}" FontSize="13"
                                       Foreground="{DynamicResource PrimaryTextBrush}"
                                       VerticalAlignment="Center" Margin="0,0,0,6"/>
                            <TextBox Grid.Column="1" Width="60"
                                     Text="{Binding DatalasticPollInterval, UpdateSourceTrigger=PropertyChanged}"
                                     Background="{DynamicResource GlassFillBrush}"
                                     Foreground="{DynamicResource PrimaryTextBrush}"
                                     BorderBrush="{DynamicResource GlassBorderBrush}"
                                     Padding="8,6" Margin="0,0,0,6"/>
                            <TextBlock Grid.Row="1" Text="{x:Static res:Strings.DataDockedPoll}" FontSize="13"
                                       Foreground="{DynamicResource PrimaryTextBrush}"
                                       VerticalAlignment="Center"/>
                            <TextBox Grid.Row="1" Grid.Column="1" Width="60"
                                     Text="{Binding DataDockedPollInterval, UpdateSourceTrigger=PropertyChanged}"
                                     Background="{DynamicResource GlassFillBrush}"
                                     Foreground="{DynamicResource PrimaryTextBrush}"
                                     BorderBrush="{DynamicResource GlassBorderBrush}"
                                     Padding="8,6"/>
                        </Grid>

                        <!-- API Keys -->
                        <TextBlock Text="{x:Static res:Strings.ApiKeys}" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,8"/>

                        <!-- AisStream -->
                        <TextBlock Text="{x:Static res:Strings.AisStreamKeyLabel}" FontSize="13"
                                   Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,4"/>
                        <Border Background="{DynamicResource GlassFillBrush}"
                                BorderBrush="{DynamicResource GlassBorderBrush}"
                                BorderThickness="1" CornerRadius="8" Margin="0,0,0,12">
                            <TextBox Text="{Binding AisStreamApiKey, UpdateSourceTrigger=PropertyChanged}"
                                     Background="Transparent"
                                     Foreground="{DynamicResource PrimaryTextBrush}"
                                     BorderThickness="0" Padding="10,8"
                                     FontFamily="Consolas" FontSize="13"/>
                        </Border>

                        <!-- Datalastic -->
                        <TextBlock Text="{x:Static res:Strings.DatalasticKeyLabel}" FontSize="13"
                                   Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,4"/>
                        <Border Background="{DynamicResource GlassFillBrush}"
                                BorderBrush="{DynamicResource GlassBorderBrush}"
                                BorderThickness="1" CornerRadius="8" Margin="0,0,0,12">
                            <TextBox Text="{Binding DatalasticApiKey, UpdateSourceTrigger=PropertyChanged}"
                                     Background="Transparent"
                                     Foreground="{DynamicResource PrimaryTextBrush}"
                                     BorderThickness="0" Padding="10,8"
                                     FontFamily="Consolas" FontSize="13"/>
                        </Border>

                        <!-- DataDocked -->
                        <TextBlock Text="{x:Static res:Strings.DataDockedKeyLabel}" FontSize="13"
                                   Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,4"/>
                        <Border Background="{DynamicResource GlassFillBrush}"
                                BorderBrush="{DynamicResource GlassBorderBrush}"
                                BorderThickness="1" CornerRadius="8" Margin="0,0,0,12">
                            <TextBox Text="{Binding DataDockedApiKey, UpdateSourceTrigger=PropertyChanged}"
                                     Background="Transparent"
                                     Foreground="{DynamicResource PrimaryTextBrush}"
                                     BorderThickness="0" Padding="10,8"
                                     FontFamily="Consolas" FontSize="13"/>
                        </Border>

                        <!-- VesselFinder -->
                        <TextBlock Text="{x:Static res:Strings.VesselFinderKeyLabel}" FontSize="13"
                                   Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,4"/>
                        <Border Background="{DynamicResource GlassFillBrush}"
                                BorderBrush="{DynamicResource GlassBorderBrush}"
                                BorderThickness="1" CornerRadius="8" Margin="0,0,0,12">
                            <TextBox Text="{Binding VesselFinderApiKey, UpdateSourceTrigger=PropertyChanged}"
                                     Background="Transparent"
                                     Foreground="{DynamicResource PrimaryTextBrush}"
                                     BorderThickness="0" Padding="10,8"
                                     FontFamily="Consolas" FontSize="13"/>
                        </Border>

                    </StackPanel>
                </ScrollViewer>

                <!-- Buttons -->
                <StackPanel Grid.Row="2" Orientation="Horizontal"
                            HorizontalAlignment="Right" Margin="0,20,0,0">
                    <Button Content="{x:Static res:Strings.Cancel}"
                            Click="CancelClick"
                            Style="{DynamicResource GhostButtonStyle}"
                            Padding="20,10" FontSize="13"
                            Margin="0,0,10,0"/>
                    <Button Content="{x:Static res:Strings.SaveRestart}"
                            Click="SaveClick"
                            Style="{DynamicResource AccentButtonStyle}"
                            Padding="24,10" FontSize="13"/>
                </StackPanel>
            </Grid>
        </Border>
    </Border>
</Window>
